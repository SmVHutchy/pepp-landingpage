---
/**
 * Layout der Rechtsseiten.
 *
 * Die Texte selbst sind Fremdtext und werden NICHT umformuliert: sie stammen
 * wortgleich aus dem bestehenden Auftritt und liegen als HTML-Fragmente in
 * src/legal/. Die Seite gibt ihnen nur Typografie.
 *
 * Bewusst schmal (--mkt-content-width-narrow, 820px) wie das FAQ: bei
 * Fliesstext über die volle Containerbreite entstehen ~100 Zeichen pro Zeile,
 * WCAG 1.4.8 nennt 80 als Obergrenze.
 *
 * Kein Sektionsrhythmus, keine Karten, keine Bewegung. Eine Rechtsseite ist
 * kein Marketing — hier zählt Lesbarkeit und dass man die Stelle wiederfindet.
 */
import Base from './Base.astro';
import Nav from '../components/sections/Nav.astro';
import Footer from '../components/sections/Footer.astro';

interface Props {
  title: string;
  description: string;
  /**
   * Rohes HTML-Fragment aus src/legal/, beginnt mit der einzigen <h1>.
   * Weglassen, wenn der Inhalt als Kindelement kommt — so bei
   * /barrierefreiheit, wo der Text nicht Fremdtext ist, sondern aus Listen im
   * Frontmatter entsteht.
   */
  body?: string;
}

const { title, description, body } = Astro.props;
---

<Base title={title} description={description}>
  <Nav />
  <main id="main" class="legal">
    {
      body ? (
        <div class="legal__inner" set:html={body} />
      ) : (
        <div class="legal__inner">
          <slot />
        </div>
      )
    }
  </main>
  <Footer />

  {
    /* Nur die Navigation, ohne GSAP. Ohne dieses Skript blieb die klebende
      Leiste auf diesen vier Seiten dauerhaft durchsichtig, und der Rechtstext
      scrollte unlesbar durch sie hindurch; ausserdem lief die Android-Weiche
      am CTA im Kopf nicht. Behebt Fund 9 und 10 aus
      docs/AUDIT-2026-08-17.md. Die Animationslogik aus site.js bleibt der
      Startseite vorbehalten — hier gibt es nichts zu animieren. */
  }
  <script>
    import '../scripts/nav.js';
  </script>
</Base>

<style is:global>
  /* is:global ist nötig, weil der Inhalt über set:html kommt und damit keine
     Astro-Scope-Attribute trägt. Die Selektoren hängen deshalb alle unter
     .legal__inner, damit sie nichts ausserhalb der Rechtsseiten treffen. */

  .legal {
    padding-block: clamp(48px, 7vw, 96px) clamp(64px, 9vw, 120px);
    background: var(--bg-app);
  }

  .legal__inner {
    max-width: var(--mkt-content-width-narrow);
    margin-inline: auto;
    padding-inline: var(--mkt-gutter);
  }

  .legal__inner h1 {
    font-family: var(--font-display);
    font-weight: var(--weight-bold);
    /* Kleiner als die H1 der Startseite: die trägt eine Werbebotschaft, diese
       ist eine Dokumentüberschrift. */
    font-size: clamp(30px, 3.6vw, 44px);
    line-height: 1.1;
    letter-spacing: var(--tracking-tight);
    color: var(--text-primary);
    margin: 0 0 var(--space-7);
  }

  .legal__inner h2 {
    font-family: var(--font-display);
    font-weight: var(--weight-bold);
    font-size: clamp(20px, 2vw, 26px);
    line-height: 1.25;
    color: var(--text-primary);
    /* Grosser Abstand nach oben, kleiner nach unten: die Überschrift gehört
       sichtbar zum folgenden Absatz, nicht zum vorherigen. */
    margin: clamp(32px, 4vw, 48px) 0 var(--space-5);
  }

  .legal__inner h3 {
    font-family: var(--font-display);
    font-weight: var(--weight-semibold);
    font-size: var(--type-h3-size);
    line-height: var(--type-h3-lh);
    color: var(--text-primary);
    margin: var(--space-7) 0 var(--space-4);
  }

  /* 62ch ist NACHGEMESSEN, nicht überschlagen: die Einheit ch ist die Breite
     der Null, und die ist in Inter schmaler als das Durchschnittszeichen.
     68ch ergaben 726px und damit 86 echte Zeichen pro Zeile. WCAG 1.4.8 nennt
     80 als Obergrenze; 62ch landen bei 78. Die volle Spaltenbreite (756px)
     wären 89 gewesen. --measure-body (42ch) ist die Gegenrichtung — für
     Fliesstext über mehrere Seiten zu schmal. */
  .legal__inner p,
  .legal__inner li {
    font-size: var(--type-bodyl-size);
    line-height: 1.65;
    color: var(--text-secondary);
    max-width: 62ch;
  }

  .legal__inner p {
    margin: 0 0 var(--space-5);
  }

  .legal__inner strong {
    color: var(--text-primary);
    font-weight: var(--weight-semibold);
  }

  .legal__inner ul,
  .legal__inner ol {
    margin: 0 0 var(--space-5);
    padding-left: var(--space-7);
  }

  .legal__inner li {
    margin-bottom: var(--space-3);
  }

  /* base.css setzt a { color: var(--pepp-coral) } — #FC6081 erreicht auf
     Off-White nur 2,9:1 und verfehlt 4,5:1. In Fliesstext mit vielen Links
     (tel:, mailto:, Aufsichtsbehörden) ist das der kritischste Ort der ganzen
     Seite. --ink-pink ist derselbe Hue abgedunkelt und erreicht 6,2:1.
     Unterstrichen, damit der Link nicht allein über Farbe erkennbar ist
     (WCAG 1.4.1). */
  .legal__inner a {
    color: var(--ink-pink);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .legal__inner a:hover {
    text-decoration-thickness: 2px;
  }

  /* „Angaben gemäß § 5 DDG" und ähnliche Zeilen direkt unter der H1. */
  .legal__inner .meta {
    margin-top: calc(-1 * var(--space-5));
    margin-bottom: var(--space-7);
    font-size: var(--type-body-size);
    color: var(--text-secondary);
  }

  .legal__inner table {
    width: 100%;
    border-collapse: collapse;
    margin: 0 0 var(--space-6);
    font-size: var(--type-body-size);
  }

  .legal__inner th,
  .legal__inner td {
    text-align: left;
    padding: var(--space-4) var(--space-5);
    border-bottom: var(--border-hair) solid var(--border-hairline);
    color: var(--text-secondary);
  }

  .legal__inner th {
    color: var(--text-primary);
    font-weight: var(--weight-semibold);
  }
</style>
