---
import '../styles/global.css';
import { SITE } from '../data/site.js';

interface Props {
  title: string;
  description: string;
  /** Open-Graph-Titel weicht auf der Startseite bewusst vom <title> ab. */
  ogTitle?: string;
  ogDescription?: string;
  twitterDescription?: string;
  /** Strukturierte Daten, serverseitig gerendert — nie per JS nachgeschoben. */
  jsonLd?: unknown[];
}

const {
  title,
  description,
  ogTitle = title,
  ogDescription = description,
  twitterDescription = description,
  jsonLd,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, SITE.origin).href;
const ogImage = new URL('/og-image.png', SITE.origin).href;
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    {
      /* Marke im Tab. SVG zuerst — moderne Browser nehmen es und skalieren
        verlustfrei; favicon.ico ist der Fallback und liegt zusätzlich unter
        dem Standardpfad, den ältere Browser ungefragt abrufen.
        Erzeugt von scripts/brand-assets.mjs aus dem Design System. */
    }
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    {
      /* --bg-app, damit die Adressleiste auf Android nicht gegen die Seite
        kontrastiert. */
    }
    <meta name="theme-color" content="#FBF6F1" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={twitterDescription} />

    {
      /* Quicksand trägt die H1 und damit den LCP-Text — früh laden, ohne zu blockieren. */
    }
    <link
      rel="preload"
      href="/fonts/Quicksand-Variable.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    {
      /* is:inline ist hier korrekt und nicht nur Beruhigung für astro check:
        das ist ein Datenblock, kein ausführbares Skript. Er soll unverändert
        im HTML stehen und nicht durch die Bündelung laufen. */
    }
    {
      jsonLd && (
        <script
          is:inline
          type="application/ld+json"
          set:html={JSON.stringify(jsonLd)}
        />
      )
    }
  </head>

  <body>
    <a class="skip-link" href="#main">Zum Inhalt springen</a>
    <slot />
  </body>
</html>
