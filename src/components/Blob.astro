---
/**
 * Farbblob — dekorativer Farbschein hinter einer Sektion.
 *
 * ZWEI BETRIEBSARTEN, und die Unterscheidung ist keine Stilfrage:
 *
 * `ton` — der einfarbige Schein aus --glow-peach / --glow-pink. Im Design
 * System sind das die Ambient-Glows HINTER DEM MASKOTTCHEN
 * (tokens/gradients.css:9). Radial, closest-side, keine Kante. Sie gehören
 * dorthin, wo eine Figur oder ein Screen etwas Licht braucht.
 *
 * `form` — der Marken-Blob aus components/brand/GradientBlob.jsx: eine der
 * fünf gezeichneten Formen, gefüllt mit dem Dawn-Verlauf. Die Regel dort ist
 * wörtlich „always the Dawn gradient — only the organic shape and size
 * change", und genau das macht die Farbigkeit der App-Screens aus: der Bogen
 * von Pfirsich über Rosa und Flieder nach Blau. Ein einfarbiger Schein kann
 * das nicht leisten.
 *
 * Umgesetzt als CSS-Maske über --gradient-dawn statt als SVG mit eigenem
 * Verlauf: der Verlauf bleibt damit der Token und wird nicht ein zweites Mal
 * als Stop-Liste abgeschrieben. Ausserdem braucht keine Instanz eine
 * eindeutige id, an der zwei Blobs auf derselben Seite kollidieren könnten.
 *
 * Das Seitenverhältnis der Formen ist 115:86 — `groesse` ist die Breite, die
 * Höhe folgt. Bei `ton` bleibt es das Quadrat, in dem der radiale Verlauf
 * ausläuft.
 *
 * MEHR ALS ZWEI PRO SEKTION NICHT. Steht so im Design System, und der Grund
 * ist sichtbar: ab dem dritten liest die Fläche als Farbnebel statt als Tiefe.
 *
 * Der Blob ist reine Dekoration: aria-hidden, pointer-events none, kein
 * Textinhalt. Er darf deshalb auch angeschnitten werden — die Reflow-Prüfung
 * in verify.mjs nimmt aria-hidden-Elemente aus.
 *
 * Bewegt wird er per ScrollTrigger mit scrub (siehe MOTION.blob in
 * motion-config.js). Ohne JavaScript steht er still an seiner Position; die
 * Sektion sieht dann trotzdem vollständig aus.
 *
 * Die aufrufende Sektion braucht `position: relative`. Wenn der Blob nicht
 * hinausragen soll, zusätzlich `overflow: hidden`.
 */

/* Die Formen liegen in src/data/blob-formen.js — der Blob-Editor braucht sie
   zur Laufzeit ebenfalls, und zwei Kopien wären zwei Stellen, an denen jemand
   eine ändern kann. */
import { FORMEN, FORM_VERHAELTNIS, maskeVon } from '../data/blob-formen.js';

interface Props {
  /**
   * Marken-Blob im Dawn-Verlauf. Eine der fünf Formen des Design Systems.
   * Wird `form` gesetzt, ist `ton` ohne Wirkung.
   */
  form?: keyof typeof FORMEN;
  /**
   * Weichzeichnung in Pixeln, nur für `form`. Die Formkante ist organisch,
   * aber scharf; das Design System verlangt „never hard-edged". Der Wert liegt
   * bewusst hoch — bei 12px sieht man die Kontur, und dann steht dort eine
   * Figur statt einer Stimmung.
   */
  weichzeichnen?: number;
  /** Welcher Verlauf. peach ist wärmer, pink kräftiger. */
  ton?: 'peach' | 'pink';
  /** Kantenlänge des Quadrats, in dem der radiale Verlauf ausläuft. */
  groesse?: string;
  /** Positionierung; alles was in inset/top/left passt. */
  top?: string;
  left?: string;
  right?: string;
  bottom?: string;
  /** Deckkraft. Die Tokens bringen schon 50-55 % mit, deshalb hier niedrig. */
  deckkraft?: number;
  /**
   * Weg in Pixeln über die gesamte Sektionshöhe. Negativ = wandert nach oben,
   * also gegen die Scrollrichtung. Unterschiedliche Werte je Blob erzeugen die
   * Tiefe; gleiche Werte wirken wie ein mitgeschobenes Hintergrundbild.
   */
  weg?: number;
}

const {
  form,
  weichzeichnen = 48,
  ton = 'peach',
  groesse = '560px',
  top,
  left,
  right,
  bottom,
  deckkraft = 0.5,
  weg = -60,
} = Astro.props;

const stil = [
  `--blob-groesse:${groesse}`,
  `--blob-deckkraft:${deckkraft}`,
  form && `--blob-maske:${maskeVon(form)}`,
  form && `--blob-weich:${weichzeichnen}px`,
  form && `--blob-verhaeltnis:${FORM_VERHAELTNIS}`,
  top && `top:${top}`,
  left && `left:${left}`,
  right && `right:${right}`,
  bottom && `bottom:${bottom}`,
]
  .filter(Boolean)
  .join(';');
---

<div
  class="blob"
  class:list={[form ? 'blob--dawn' : `blob--${ton}`]}
  style={stil}
  data-blob={weg}
  data-form={form}
  aria-hidden="true"
>
</div>

<style>
  .blob {
    position: absolute;
    width: var(--blob-groesse);
    height: var(--blob-groesse);
    opacity: var(--blob-deckkraft);
    pointer-events: none;
    z-index: 0;
    /* Nur auf Elementen, die sich wirklich bewegen. */
    will-change: transform;
  }

  .blob--peach {
    background: var(--glow-peach);
  }

  .blob--pink {
    background: var(--glow-pink);
  }

  /* Der Marken-Blob. Die Höhe folgt dem Seitenverhältnis der Formen (115:86),
     sonst wären die Pfade gestaucht.

     Der Weichzeichner steht auf dem Element, das ohnehin `will-change:
     transform` trägt und damit eine eigene Ebene bekommt. Das Bild wird also
     einmal unscharf gerechnet und beim Scrollen nur noch verschoben — nicht
     in jedem Einzelbild neu. Ohne die eigene Ebene wäre ein 600px grosser
     blur(48px) am Scrub die teuerste Zeile der Seite.

     mask-repeat: no-repeat ist Pflicht. Die Vorgabe ist `repeat`, und dann
     kachelt die Form über die ganze Fläche, sobald sie kleiner steht als der
     Kasten. */
  .blob--dawn {
    height: calc(var(--blob-groesse) * var(--blob-verhaeltnis));
    background: var(--gradient-dawn);
    filter: blur(var(--blob-weich));
    mask-image: var(--blob-maske);
    mask-repeat: no-repeat;
    mask-size: 100% 100%;
    -webkit-mask-image: var(--blob-maske);
    -webkit-mask-repeat: no-repeat;
    -webkit-mask-size: 100% 100%;
  }
</style>
