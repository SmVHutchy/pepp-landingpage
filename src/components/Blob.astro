---
/**
 * Farbblob — dekorativer Farbschein hinter einer Sektion.
 *
 * ZWEI BETRIEBSARTEN, und die Unterscheidung ist keine Stilfrage:
 *
 * `ton` — der einfarbige Schein aus --glow-peach / --glow-pink. Im Design
 * System sind das die Ambient-Glows HINTER DEM MASKOTTCHEN
 * (tokens/gradients.css:9). Radial, closest-side, keine Kante. Sie gehören
 * dorthin, wo eine Figur oder ein Screen etwas Licht braucht.
 *
 * `form` — der Marken-Blob aus components/brand/GradientBlob.jsx: eine der
 * fünf gezeichneten Formen, gefüllt mit dem Dawn-Verlauf. Die Regel dort ist
 * wörtlich „always the Dawn gradient — only the organic shape and size
 * change", und genau das macht die Farbigkeit der App-Screens aus: der Bogen
 * von Pfirsich über Rosa und Flieder nach Blau. Ein einfarbiger Schein kann
 * das nicht leisten.
 *
 * Umgesetzt als CSS-Maske über --gradient-dawn statt als SVG mit eigenem
 * Verlauf: der Verlauf bleibt damit der Token und wird nicht ein zweites Mal
 * als Stop-Liste abgeschrieben. Ausserdem braucht keine Instanz eine
 * eindeutige id, an der zwei Blobs auf derselben Seite kollidieren könnten.
 *
 * Das Seitenverhältnis der Formen ist 115:86 — `groesse` ist die Breite, die
 * Höhe folgt. Bei `ton` bleibt es das Quadrat, in dem der radiale Verlauf
 * ausläuft.
 *
 * MEHR ALS ZWEI PRO SEKTION NICHT. Steht so im Design System, und der Grund
 * ist sichtbar: ab dem dritten liest die Fläche als Farbnebel statt als Tiefe.
 *
 * Der Blob ist reine Dekoration: aria-hidden, pointer-events none, kein
 * Textinhalt. Er darf deshalb auch angeschnitten werden — die Reflow-Prüfung
 * in verify.mjs nimmt aria-hidden-Elemente aus.
 *
 * Bewegt wird er per ScrollTrigger mit scrub (siehe MOTION.blob in
 * motion-config.js). Ohne JavaScript steht er still an seiner Position; die
 * Sektion sieht dann trotzdem vollständig aus.
 *
 * Die aufrufende Sektion braucht `position: relative`. Wenn der Blob nicht
 * hinausragen soll, zusätzlich `overflow: hidden`.
 */

/* Die Formen liegen in src/data/blob-formen.js — der Blob-Editor braucht sie
   zur Laufzeit ebenfalls, und zwei Kopien wären zwei Stellen, an denen jemand
   eine ändern kann. */
import { FORMEN, FORM_VERHAELTNIS, maskeVon } from '../data/blob-formen.js';

interface Props {
  /**
   * Marken-Blob im Dawn-Verlauf. Eine der fünf Formen des Design Systems.
   * Wird `form` gesetzt, ist `ton` ohne Wirkung.
   */
  form?: keyof typeof FORMEN;
  /**
   * Weichzeichnung in Pixeln, nur für `form`. Die Formkante ist organisch,
   * aber scharf; das Design System verlangt „never hard-edged". Der Wert liegt
   * bewusst hoch — bei 12px sieht man die Kontur, und dann steht dort eine
   * Figur statt einer Stimmung.
   */
  weichzeichnen?: number;
  /** Welcher Verlauf. peach ist wärmer, pink kräftiger. */
  ton?: 'peach' | 'pink';
  /**
   * Dreht den Verlauf IM Blob, nur für `form`. 0 = wie der Token (135°).
   *
   * Warum es diesen Regler braucht: ein Blob, der in einer Ecke sitzt, liegt
   * zu einem guten Teil ausserhalb der Sektion. Sichtbar bleibt dann nur ein
   * Abschnitt des Bogens — meist das Pfirsich-Rosa-Ende —, und die Fläche
   * liest sich als einfarbiger Schleier statt als Dawn. Gedreht wandern
   * Flieder und Blau in den sichtbaren Ausschnitt.
   *
   * Gedreht wird die Ebene, auf der der Verlauf liegt, nicht die Stop-Liste:
   * --gradient-dawn bleibt unangetastet der Token.
   */
  winkel?: number;
  /**
   * Sättigung des Verlaufs, nur für `form`. 1 = unverändert.
   *
   * Hebt die Farbigkeit, ohne die Deckkraft anzufassen — und das ist der
   * Unterschied, der zählt: mehr Deckkraft verdunkelt die Fläche und frisst
   * den Textkontrast darüber, mehr Sättigung nicht.
   */
  saettigung?: number;
  /** Kantenlänge des Quadrats, in dem der radiale Verlauf ausläuft. */
  groesse?: string;
  /**
   * Positionierung. Zwei Kanten genügen, eine senkrechte und eine waagerechte.
   *
   * PROZENTE BEZIEHEN SICH AUF DEN BLOB, NICHT AUF DIE SEKTION — und das ist
   * der Unterschied zwischen brauchbar und unbrauchbar. In CSS rechnet `top:
   * -18%` gegen die Höhe des Elternteils. Solange alle Sektionen ungefähr
   * gleich hoch sind, fällt das nicht auf; sobald eine anhält und 3300px hoch
   * wird, sind dieselben 18 % dort 601px statt 150px, und von einem 718px
   * hohen Blob bleiben 117px stehen. Gemessen an „So funktioniert's" und der
   * Mechanik, nachdem beide einen Halt bekommen hatten.
   *
   * Gegen den Blob gerechnet heisst -18% immer dasselbe: 18 % der Form hängen
   * über die Kante hinaus, in jeder Sektion, bei jeder Höhe.
   *
   * Pixelwerte bleiben Pixelwerte und gehen unverändert durch.
   */
  top?: string;
  left?: string;
  right?: string;
  bottom?: string;
  /** Deckkraft. Die Tokens bringen schon 50-55 % mit, deshalb hier niedrig. */
  deckkraft?: number;
  /**
   * Weg in Pixeln über die gesamte Sektionshöhe. Negativ = wandert nach oben,
   * also gegen die Scrollrichtung. Unterschiedliche Werte je Blob erzeugen die
   * Tiefe; gleiche Werte wirken wie ein mitgeschobenes Hintergrundbild.
   */
  weg?: number;
}

const {
  form,
  weichzeichnen = 48,
  ton = 'peach',
  winkel = 0,
  saettigung = 1,
  groesse = '560px',
  top,
  left,
  right,
  bottom,
  deckkraft = 0.5,
  weg = -60,
} = Astro.props;

/* Die Bezugsgrössen für Prozentangaben: die eigene Breite und die eigene
   Höhe. Beim Marken-Blob folgt die Höhe dem Seitenverhältnis der Formen, beim
   Glow ist die Fläche quadratisch. */
const EIGEN_X = 'var(--blob-mass)';
const EIGEN_Y = form
  ? `calc(var(--blob-mass) * ${FORM_VERHAELTNIS})`
  : 'var(--blob-mass)';

/* Prozent gegen den Blob rechnen, Pixel unverändert lassen. Die Zahl wandert
   zusätzlich in ein data-Attribut: der Blob-Editor liest sie von dort und muss
   keinen calc()-Ausdruck zurückübersetzen. */
const kanten = { top, bottom, left, right };
const zahlen: Record<string, string> = {};
const stilKanten = [];
for (const [seite, wert] of Object.entries(kanten)) {
  if (!wert) continue;
  const roh = String(wert).trim();
  if (!roh.endsWith('%')) {
    stilKanten.push(`${seite}:${roh}`);
    continue;
  }
  const p = parseFloat(roh);
  const senkrecht = seite === 'top' || seite === 'bottom';
  const bezug = senkrecht ? EIGEN_Y : EIGEN_X;
  /* Die Schranken sind auf dem Desktop absichtlich unerreichbar weit und
     greifen erst unter 901px — siehe --blob-rand-* im Stil unten. */
  const grenze = senkrecht
    ? ['--blob-rand-y-min', '--blob-rand-y-max']
    : ['--blob-rand-x-min', '--blob-rand-x-max'];
  stilKanten.push(
    `${seite}:clamp(var(${grenze[0]}),calc(${bezug} * ${p / 100}),var(${grenze[1]}))`
  );
  zahlen[`data-pos-${seite}`] = String(p);
}

const stil = [
  `--blob-groesse:${groesse}`,
  `--blob-deckkraft:${deckkraft}`,
  form && `--blob-maske:${maskeVon(form)}`,
  form && `--blob-weich:${weichzeichnen}px`,
  form && `--blob-verhaeltnis:${FORM_VERHAELTNIS}`,
  form && `--blob-winkel:${winkel}deg`,
  form && `--blob-saettigung:${saettigung}`,
  ...stilKanten,
]
  .filter(Boolean)
  .join(';');
---

<div
  class="blob"
  class:list={[form ? 'blob--dawn' : `blob--${ton}`]}
  style={stil}
  data-blob={weg}
  data-form={form}
  data-ton={form ? undefined : ton}
  {...zahlen}
  aria-hidden="true"
>
</div>

<style>
  /* DIE GESETZTE GRÖSSE GILT FÜR EINE 1440px BREITE FLÄCHE, und darunter wird
     sie mitskaliert. Ohne das bricht die Komposition auf dem Handy zusammen:
     gemessen lagen bei 390px 24 von 33 Blobs zu weniger als 10 % in ihrer
     Sektion, 18 waren breiter als das Dreifache des Viewports.

     Der Grund ist die Einheit. `groesse` steht in Pixeln — richtig, damit ein
     Blob auf schmalem Schirm nicht zum Fleck schrumpft. Ein Wert von 1800px
     ist auf 1440px aber das 1,25-Fache der Breite und auf 390px das
     4,6-Fache. Und weil die Kanten in Prozent DES BLOBS rechnen, wächst der
     Versatz mit: -19,6 % sind hier 353px, dort 353px bei einem Blob, der
     viermal breiter ist als das Bild. Was auf dem Desktop in der Ecke sass,
     liegt auf dem Handy vollständig daneben.

     Mit einem gemeinsamen Faktor bleibt das Verhältnis erhalten: Grösse und
     Versatz schrumpfen zusammen, die Ecke bleibt die Ecke. Der Faktor ist
     nicht linear bis null — bei 0,42 ist Schluss, sonst wäre auf 390px vom
     Bogen wieder nichts zu sehen, und genau davor sollte die Pixelangabe
     ursprünglich schützen.

     Gestuft und nicht stufenlos: an einem Weichzeichner mit 60px Radius ist
     der Sprung an einer Breakpoint-Kante nicht zu sehen, und eine Stufe kann
     man nachlesen. 901px ist die Kante, die das Projekt ohnehin überall
     benutzt. */
  .blob {
    --blob-skala: 1;
    --blob-mass: calc(var(--blob-groesse) * var(--blob-skala));
    /* Schranken für die Kanten. Auf dem Desktop unerreichbar weit: die
       gesetzten Werte kommen unverändert durch, auch die, die absichtlich
       ganz ausserhalb liegen. */
    --blob-rand-x-min: -100000px;
    --blob-rand-x-max: 100000px;
    --blob-rand-y-min: -100000px;
    --blob-rand-y-max: 100000px;
    position: absolute;
    width: var(--blob-mass);
    height: var(--blob-mass);
    opacity: var(--blob-deckkraft);
    pointer-events: none;
    z-index: 0;
    /* Nur auf Elementen, die sich wirklich bewegen. */
    will-change: transform;
  }

  .blob--peach {
    background: var(--glow-peach);
  }

  .blob--pink {
    background: var(--glow-pink);
  }

  /* Der Marken-Blob. Die Höhe folgt dem Seitenverhältnis der Formen (115:86),
     sonst wären die Pfade gestaucht.

     Der Weichzeichner steht auf dem Element, das ohnehin `will-change:
     transform` trägt und damit eine eigene Ebene bekommt. Das Bild wird also
     einmal unscharf gerechnet und beim Scrollen nur noch verschoben — nicht
     in jedem Einzelbild neu. Ohne die eigene Ebene wäre ein 600px grosser
     blur(48px) am Scrub die teuerste Zeile der Seite.

     mask-repeat: no-repeat ist Pflicht. Die Vorgabe ist `repeat`, und dann
     kachelt die Form über die ganze Fläche, sobald sie kleiner steht als der
     Kasten. */
  @media (max-width: 1439px) {
    .blob {
      --blob-skala: 0.78;
    }
  }

  /* Unter 901px greifen die Schranken: ein Viertel des Blobs muss in der
     Sektion bleiben.

     Die Grösse allein reicht hier nicht. Ein Blob bei `left: 108%` steht auf
     einer 1440px breiten Sektion knapp am rechten Rand — auf 390px liegt
     derselbe Wert vollständig daneben, weil sich das Seitenverhältnis der
     Sektion ändert und nicht nur ihr Massstab. Gemessen blieben nach der
     Skalierung noch 11 von 33 Blobs unter 10 % Sichtbarkeit, auf dem Desktop
     sind es 5.

     `100%` bezieht sich in einer Kantenangabe auf die Sektion, `--blob-mass`
     auf den Blob — beides in einer Rechnung ist genau das, was hier gebraucht
     wird und was sich in der Prozentangabe allein nicht ausdrücken lässt. */
  @media (max-width: 900px) {
    .blob {
      --blob-skala: 0.55;
      --blob-rand-x-min: calc(var(--blob-mass) * -0.75);
      --blob-rand-x-max: calc(100% - var(--blob-mass) * 0.25);
      --blob-rand-y-min: calc(var(--blob-mass) * -0.75);
      --blob-rand-y-max: calc(100% - var(--blob-mass) * 0.25);
    }
  }

  @media (max-width: 479px) {
    .blob {
      --blob-skala: 0.42;
    }
  }

  .blob--dawn {
    height: calc(var(--blob-mass) * var(--blob-verhaeltnis));
    filter: blur(var(--blob-weich));
    mask-image: var(--blob-maske);
    mask-repeat: no-repeat;
    mask-size: 100% 100%;
    -webkit-mask-image: var(--blob-maske);
    -webkit-mask-repeat: no-repeat;
    -webkit-mask-size: 100% 100%;
  }

  /* Der Verlauf liegt auf einer eigenen Ebene, nicht auf dem Blob selbst —
     nur so lässt er sich drehen, ohne die Form mitzudrehen. Die Maske des
     Elternteils beschneidet das Pseudoelement mit, die Form bleibt also
     genau die gezeichnete.

     inset: -50% ist kein geschätzter Wert: gedreht braucht eine Fläche das
     √2-fache ihrer Kantenlänge, um den Ausschnitt bei jedem Winkel noch zu
     decken. Bei -50% ist sie doppelt so gross, damit auch bei 45° keine
     leere Ecke auftaucht. */
  .blob--dawn::before {
    content: '';
    position: absolute;
    inset: -50%;
    background: var(--gradient-dawn);
    rotate: var(--blob-winkel, 0deg);
    filter: saturate(var(--blob-saettigung, 1));
  }
</style>
