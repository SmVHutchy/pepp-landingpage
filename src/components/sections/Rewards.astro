---
/* Sektion 6 · Belohnungen (#belohnungen)
   Off-White. Eine Bühne, mehr nicht: Kopf mittig, Pepp in der Mitte, die vier
   Reward-Typen als Chips um ihn herum.

   WARUM DAS DAWN-BAND WEG IST. Vorher lag der Verlauf als randloses Band in
   voller Sättigung über die Sektionsbreite und trug zwei weisse Karten mit
   Fliesstext. Das Design System sagt zum Dawn: „always soft and large" und
   „never as a container for long text" — genau beides war verletzt. Die
   Fläche schrie lauter als die Aussage, und die Karten sassen darin wie
   ausgeschnitten. Jetzt ist der Verlauf da, wo ihn das System vorsieht:
   als weicher Schein hinter dem Maskottchen, ohne Kante.

   WARUM VIER CHIPS UND NICHT ZWEI. Die App kennt vier Reward-Typen — der
   Auswahlschritt in „Quest erstellen" zeigt Geld · Medienzeit · Eigene ·
   Keine (ui_kits/parent_app/QuestCreate.jsx:66). Die Sektion zeigte davon
   zwei und liess die Aussage „du entscheidest" unbelegt. Die Chips sind die
   vollständige Auswahl in derselben Reihenfolge wie im Produkt — und sie sind
   seit dem Kundendurchgang vom 01.09.2026 die einzige Aufzählung hier.

   WARUM UNTER DER BÜHNE NICHTS MEHR STEHT. Bis dahin folgten zwei Detailkarten
   (Goldmünze · Taschengeld, Zeitmünze · Medienzeit) und darunter das Zitat
   „Medienzeit wird verdient, nicht verhandelt." Zusammen 727px von 1705px bei
   1440x900 — knapp die Hälfte der Sektion für eine Aussage, die die vier Chips
   darüber schon tragen. Der Kunde hat alle drei gestrichen, das Zitat
   ausdrücklich eingeschlossen.

   Mit dem Teilbaum fielen zwei ältere Begründungen weg, die ohnehin ins Leere
   zeigten: der Absatz zum Schalter („weisse Pille statt schwarzem Knopf") und
   der zum nativen <details>. Beide beschrieben Markup, das schon Commit
   6f10f13 aufgelöst hatte, als die Detailansicht dauerhaft aufgeklappt wurde. */
import { Image } from 'astro:assets';
import Blob from '../Blob.astro';
import BlobFeld from '../BlobFeld.astro';
import Icon from '../Icon.astro';
/* moment-reward-unlocked.png stand vorher klein und angeschnitten unten rechts
   neben dem Zitat. Dort war von der Szene nichts zu erkennen. Als Figur in der
   Mitte trägt derselbe Render die Sektion — es ist der gelieferte Augenblick
   „Belohnung freigeschaltet", also genau das, wovon die Sektion spricht. */
import moment from '../../assets/mascot/moment-reward-unlocked.png';

/* Reihenfolge und Beschriftung wie im Auswahlschritt der App. „Eigene" heisst
   hier „Eigene Belohnung": im Produkt steht darüber die Zeile „Reward wählen",
   auf der Seite steht der Chip für sich allein. */
const REWARDS = [
  {
    label: 'Geld',
    icon: 'euro',
    tint: 'var(--pepp-gold-tint)',
    ink: 'var(--ink-gold)',
  },
  {
    label: 'Medienzeit',
    icon: 'clock',
    tint: 'var(--pepp-lilac-tint)',
    ink: 'var(--ink-lilac)',
  },
  {
    label: 'Eigene Belohnung',
    icon: 'gift',
    tint: 'var(--pepp-pink-tint)',
    ink: 'var(--ink-pink)',
  },
  {
    label: 'Keine',
    icon: 'circle-slash',
    tint: 'var(--surface-sunken)',
    ink: 'var(--text-secondary)',
  },
];
---

<section id="belohnungen" class="rewards">
  {
    /* Von Liam im Blob-Editor gesetzt. Der Schein in .rewards__aura weiter
     unten gehoert nicht dazu — der liegt hinter dem Screen, nicht hinter der
     Sektion. */
  }
  <BlobFeld>
    <Blob
      ton="pink"
      groesse="1790px"
      top="-38.7%"
      left="16.5%"
      deckkraft={0.26}
      weg={-60}
    />
    <Blob
      ton="peach"
      groesse="800px"
      top="-12.3%"
      left="168%"
      deckkraft={0.26}
      weg={-60}
    />
    <Blob
      ton="peach"
      groesse="800px"
      top="-67.7%"
      left="59.8%"
      deckkraft={0.26}
      weg={-60}
    />
  </BlobFeld>
  <div class="mkt-container rewards__inner">
    <div class="rewards__head">
      <p class="mkt-label" data-anim>Belohnungen</p>
      <h2 class="mkt-h2 rewards__h2" data-anim>Belohnen nach deinen Regeln.</h2>
      <p class="mkt-lead rewards__lead" data-anim>
        Geld, Medienzeit, eine eigene Belohnung &#8212; oder keine. Du entscheidest pro
        Aufgabe.
      </p>
    </div>

    {
      /* Die Bühne. Ab 901px ein Raster aus drei Spalten: Chips links, Figur in
        der Mitte über beide Zeilen, Chips rechts. Darunter steht die Figur
        oben und die Chips laufen als umbrechende Reihe darunter — abseits
        vom Raster gibt es dort keine Seiten, zwischen die etwas passt.

        display:contents an der Liste löst nur den Kasten auf, die vier <li>
        werden dadurch selbst Rasterfelder. role="list" steht daneben, weil
        Safari mit display:contents sonst die Listensemantik verliert. */
    }
    <div class="rewards__scene">
      <div class="rewards__aura" aria-hidden="true">
        <Blob ton="pink" groesse="100%" deckkraft={0.5} weg={-40} />
      </div>

      <div class="rewards__figure" data-anim="card">
        <Image
          src={moment}
          alt="Pepp springt mit einer Goldmünze — eine Belohnung ist freigeschaltet."
          width={400}
          height={392}
          widths={[240, 320, 400, 560, 800]}
          sizes="(max-width: 900px) 60vw, (min-width: 1340px) 400px, 30vw"
          format="webp"
          loading="lazy"
        />
      </div>

      <ul class="rewards__chips mkt-list-reset" role="list">
        {
          REWARDS.map((reward) => (
            <li class="rewards__chip" data-anim="card">
              <span
                class="rewards__chip-tile mkt-tile"
                style={`background:${reward.tint}`}
              >
                <Icon name={reward.icon} size={20} color={reward.ink} />
              </span>
              {reward.label}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .rewards {
    position: relative;
    /* Beschneidet .rewards__aura an der Sektionskante. Der Schein ist 760px
       hoch und steht 55px über die Unterkante hinaus (gemessen 1440x900,
       01.09.2026) — ohne den Beschnitt läuft rosa Licht in „Die Mechanik".

       Die frühere Begründung „damit die Seite bei 320px nicht waagerecht
       scrollt" trifft nicht mehr zu und wurde nachgeprüft: ohne diese Zeile
       gebaut bleibt scrollWidth bei 320px exakt 320px. Waagerecht halten die
       Seite body{overflow-x:hidden} (global.css:19) und die eigene Clip-Ebene
       der Blobs (BlobFeld.astro) — die grossen Blobs hängen dort drin, nur die
       Aura nicht. */
    overflow: hidden;
    background: var(--bg-app);
    padding-block: var(--mkt-section-y);
  }

  /* Wie „Alltag" und „Sicherheit" füllt die Sektion ab Desktop den Bildschirm,
     statt ihre Höhe aus dem Inhalt zu ziehen. Bei 1440x1080 waren die beiden
     Nachbarn exakt 1080 hoch und diese hier 1034 — 46 Pixel, die man beim
     Scrollen nicht als Zahl sieht, aber als Ruck: die Bühne stand einen Tick
     zu hoch im Bild, während die Sektionen davor und danach sauber standen.

     Anders als dort steht hier KEIN data-haftet im Markup. Die Rechnung
     „genau 100svh und keinen Pixel mehr" aus Problem.astro gilt deshalb
     nicht — sie hängt an initSticky(), das hier nichts zu tun hat. 100svh ist
     hier schlicht das Mass der Nachbarn.

     min-height statt height: seit die Detailkarten und das Zitat weg sind,
     misst der Inhalt 922px (1440, gemessen 01.09.2026). Auf einem 900er oder
     800er Laptopschirm ist er damit immer noch höher als 100svh und die
     Sektion bleibt inhaltsgetrieben; erst ab etwa 922px Fensterhöhe greift der
     Boden und zieht sie auf das Mass der Nachbarn. Mit height statt min-height
     wäre es umgekehrt: der Inhalt würde auf 800 gestaucht und .rewards
     schnitte ihn mit overflow:hidden ab.

     width auf dem Container, weil `margin-inline: auto` an einem Grid-Item die
     Streckung abschaltet — die lange Begründung steht in Problem.astro. */
  @media (min-width: 901px) {
    .rewards {
      display: grid;
      align-items: center;
      min-height: 100svh;
    }

    .rewards > .rewards__inner {
      width: 100%;
    }
  }

  .rewards__inner {
    position: relative;
    z-index: 1;
  }

  /* Der Kopf steht mittig, nicht wie sonst zweispaltig links: die Bühne
     darunter ist symmetrisch, und ein linksbündiger Kopf über einer mittigen
     Figur kippt das Bild. Deshalb hier auch kein .mkt-head — dessen
     Desktop-Regel würde den Lead nach rechts neben die Headline setzen. */
  .rewards__head {
    text-align: center;
    display: grid;
    justify-items: center;
    gap: var(--space-5);
  }

  .rewards__head > * {
    margin: 0;
  }

  /* --measure-headline (16ch) ist für linksbündige Headlines gerechnet und
     bräche eine mittige Zeile in drei ungleiche Stücke. 18ch hält die
     Kundenfassung „Belohnen nach deinen Regeln." bei zwei Zeilen — gemessen
     356x112px bei 1440 und 205x65px bei 390 und 320, also überall zweizeilig. */
  .rewards__h2 {
    max-width: 18ch;
  }

  .rewards__lead {
    font-size: var(--type-bodyl-size);
    line-height: var(--type-bodyl-lh);
  }

  /* ── Bühne ─────────────────────────────────────────────────────────────
     Unter 901px: Figur oben, Chips als umbrechende Reihe darunter. */
  .rewards__scene {
    position: relative;
    margin-top: var(--mkt-stack-gap);
    display: grid;
    justify-items: center;
    gap: clamp(24px, 3vw, 40px);
  }

  /* Der Schein liegt hinter der Figur und ist das einzige Stück Farbe der
     Sektion, das Fläche wird. <Blob> bringt den radialen --glow-pink des
     Design Systems mit und hängt am Scroll-Scrub (data-blob) — deshalb hier
     nur die Position und keine eigene Farbe. */
  .rewards__aura {
    position: absolute;
    top: 50%;
    left: 50%;
    translate: -50% -50%;
    width: min(760px, 92vw);
    aspect-ratio: 1;
    pointer-events: none;
    z-index: 0;
  }

  .rewards__figure {
    position: relative;
    z-index: 1;
  }

  .rewards__figure img {
    display: block;
    width: clamp(240px, 30vw, 400px);
    height: auto;
    /* --shadow-mascot ist im Design System genau dieser Wert — der Render
       bringt keinen Bodenschatten mit. */
    filter: drop-shadow(var(--shadow-mascot));
  }

  .rewards__chips {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-4);
  }

  /* Links 8px, rechts 20px. Das ist kein zu knapper Rand, sondern die Folge
     davon, dass an der linken Kante das runde 32px-Tile steht und an der
     rechten die Textkante: 8px sind der Ring um das Tile, der Text hat auf
     seiner Seite die vollen 20px. Wer die Kartenregel „mindestens 16px bis zum
     Text“ hier prüft, misst sonst gegen das Tile und meldet einen Verstoss,
     den es nicht gibt. */
  .rewards__chip {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-3) var(--space-6) var(--space-3) var(--space-3);
    background: var(--surface-card);
    border: var(--border-hair) solid var(--border-hairline);
    border-radius: var(--radius-pill);
    box-shadow: var(--shadow-1);
    font-size: var(--type-body-size);
    font-weight: var(--weight-semibold);
    color: var(--text-primary);
    white-space: nowrap;
  }

  /* .mkt-tile ist 40px; hier reichen 32px, weil die Pille sonst zu hoch wird. */
  .rewards__chip-tile {
    width: 32px;
    height: 32px;
  }

  @media (min-width: 901px) {
    /* Drei Spalten: Chips · Figur · Chips. Die Figur steht über beide Zeilen,
       die vier Chips sitzen in den Ecken und werden je einzeln ein Stück
       versetzt — gleiche Abstände lesen sich als Tabelle, nicht als Szene.

       CSS `translate` und nicht `transform`: die Reveal-Animation schreibt in
       `transform`, beide Eigenschaften werden getrennt gerechnet und addiert
       sich. Der Versatz überlebt also die Animation. */
    .rewards__scene {
      grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
      align-items: center;
      column-gap: clamp(16px, 3vw, 48px);
      row-gap: 0;
    }

    .rewards__chips {
      display: contents;
    }

    .rewards__figure {
      grid-column: 2;
      grid-row: 1 / span 2;
    }

    .rewards__chip:nth-child(1) {
      grid-area: 1 / 1;
      justify-self: end;
      translate: -8px 12px;
    }

    .rewards__chip:nth-child(2) {
      grid-area: 1 / 3;
      justify-self: start;
      translate: 6px -16px;
    }

    .rewards__chip:nth-child(3) {
      grid-area: 2 / 1;
      justify-self: end;
      translate: 16px -8px;
    }

    .rewards__chip:nth-child(4) {
      grid-area: 2 / 3;
      justify-self: start;
      translate: -6px 14px;
    }
  }

  /* Die Regeln für .rewards__more, .rewards__card, .rewards__panel,
     .rewards__points und .rewards__quote sind mit ihrem Markup gegangen. Sie
     hatten ausser der Sektion keinen zweiten Nutzer — .mkt-figure__* in
     global.css, das die Karten für Titel und Body benutzten, bleibt und wird
     weiterhin vom „Alltag" gebraucht. */
</style>
