---
/* Sektion 12 · Preis (#preis)
   Weiss mit Radius oben. Enthält CTA-Instanz 4.

   Kein Preis steht hier als Literal: alles kommt aus PRICING in
   src/data/site.js. Ändert sich der Preis, ändert sich diese Sektion, das
   JSON-LD und die FAQ-Antwort in einem Zug. */
import { Image } from 'astro:assets';
import Cta from '../Cta.astro';
import Icon from '../Icon.astro';
import Blob from '../Blob.astro';
import BlobFeld from '../BlobFeld.astro';
import wave from '../../assets/mascot/pepp-wave.png';
import {
  PRICING,
  formatEuro,
  yearlyPerMonth,
  yearlySavingsPercent,
} from '../../data/site.js';

const monthly = formatEuro(PRICING.monthly);
const yearly = formatEuro(PRICING.yearly);

const included = [
  'Quests statt Diskussionen',
  'Geld- und Medienzeit-Belohnungen',
  'Die ganze Familie zieht mit',
];
---

{/* XL-Padding: eine der drei Sektionen, die das Argument tragen. */}
<section id="preis" class="price mkt-section mkt-section--xl mkt-section--card">
  {
    /* Weiss. Oben rechts, und mit Abstand am schwächsten: hier wird entschieden, nicht gestaunt. */
  }
  {/* Von Liam im Blob-Editor gesetzt. */}
  <BlobFeld>
    <Blob
      form="blob1"
      groesse="1800px"
      top="51.6%"
      left="-19.4%"
      deckkraft={0.26}
      weichzeichnen={64}
      winkel={275}
      weg={-60}
    />
    <Blob
      ton="pink"
      groesse="830px"
      top="69.4%"
      left="65.5%"
      deckkraft={0.26}
      weg={-60}
    />
    <Blob
      ton="pink"
      groesse="1800px"
      top="0.2%"
      left="-28%"
      deckkraft={0.26}
      weg={-60}
    />
  </BlobFeld>

  <div class="mkt-container price__inner">
    <div class="mkt-head">
      <p class="mkt-label" data-anim>Preis</p>
      <h2 class="mkt-h2" data-anim>Heute gratis starten. Morgen weniger Stress.</h2>
      {
        /* Wortlaut vom Kunden, 01.09.2026. Die Zahl bleibt {PRICING.trialDays}
          und wird NICHT als Ziffer getippt: der CTA-Text, die FAQ, die
          Trust-Zeile unten und diese Zeile müssen dieselbe Testdauer nennen,
          sonst widerspricht die Seite sich selbst. Genau dieser Fehlertyp ist
          als Fund 8 in docs/AUDIT-2026-08-17.md:311 dokumentiert — dort mit
          fünf hart getippten „14 Tage". Die Regel dahinter ist ADR-009 in
          docs/DECISIONS.md. */
      }
      <p class="mkt-lead price__lead" data-anim>
        {PRICING.trialDays} Tage voller kostenloser Zugriff. Danach ein Preis, ein Familien-Account,
        jederzeit kündbar.
      </p>
    </div>

    <div class="price__plans">
      {
        /* Die Monatskarte trägt drei Zeilen, die Jahreskarte zwölf — links
          blieben dadurch gut 200px weisse Fläche stehen, die grösste Lücke der
          Seite. Da steht jetzt Pepp und winkt zur empfohlenen Karte hinüber.

          In der Spalte statt absolut: die Lücke ist genau so hoch, wie die
          Karte kurz ist, und das ändert sich mit jeder Zeile im Jahresplan.
          Ein absoluter Wert wäre bei der nächsten Textänderung falsch. */
      }
      <div class="price__col">
        <div class="price__plan" data-anim="card">
          <h3 class="mkt-label price__kicker">Monatlich</h3>
          <p class="price__amount">{monthly}</p>
          <p class="price__meta">pro Monat &#183; monatlich kündbar</p>
        </div>

        <div class="price__wave u-desk" aria-hidden="true" data-anim="card">
          <Image
            src={wave}
            alt=""
            width={196}
            height={230}
            densities={[1, 2]}
            format="webp"
            loading="lazy"
          />
        </div>
      </div>

      <div class="price__plan price__plan--featured" data-anim="card">
        <div class="price__head">
          <h3 class="mkt-label price__kicker">Jährlich</h3>
          <span class="price__badge">
            Beliebt &#183; spart {yearlySavingsPercent()}&#8239;%
          </span>
        </div>
        <p class="price__amount">{yearly}</p>
        <p class="price__meta">pro Jahr &#183; nur {yearlyPerMonth()} im Monat</p>

        <ul class="price__list mkt-list-reset">
          {
            included.map((item) => (
              <li>
                <Icon name="check" size={20} color="var(--pepp-success)" />
                {item}
              </li>
            ))
          }
        </ul>

        <Cta block />

        <p class="price__fine">
          0 &#8364; heute &#183; danach {yearly} / Jahr &#183; Kündigung mit einem Tipp
        </p>
      </div>
    </div>

    <p class="price__trust" data-anim>
      {PRICING.trialDays} Tage gratis &#183; Erinnerung vor Ablauf &#183; jederzeit kündbar
    </p>
  </div>
</section>

<style>
  .price {
    position: relative;
    overflow: hidden;
  }

  .price__inner {
    position: relative;
  }

  /* Kein margin-top: der Abstand kommt aus dem gap von .mkt-head. */
  .price__lead {
    font-size: var(--type-bodyl-size);
    line-height: var(--type-bodyl-lh);
  }

  .price__plans {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr));
    gap: var(--mkt-card-gap);
    margin-top: var(--mkt-stack-gap);
    align-items: start;
  }

  /* Die Spalte ist nur eine Klammer um Karte und Figur — sie darf im Raster
     nicht als Karte wirken, also kein Hintergrund und kein Rahmen. */
  .price__col {
    display: flex;
    flex-direction: column;
    /* Das Raster steht auf align-items:start, damit die kurze Monatskarte
       nicht auf Jahreskartenhöhe gezogen wird. Die Klammer darum muss aber
       voll durchlaufen — sonst hat das margin-top:auto der Figur nichts, wogegen
       es drückt. Die Karte darin bleibt trotzdem inhaltshoch. */
    align-self: stretch;
  }

  /* margin-top:auto schiebt die Figur an den Fuss der Spalte, egal wie hoch
     die Jahreskarte daneben gerade ist. justify-content:center stellt sie
     unter die Mitte der Monatskarte statt an deren linke Kante. */
  .price__wave {
    margin-top: auto;
    padding-top: clamp(24px, 3vw, 40px);
    display: flex;
    justify-content: center;
    pointer-events: none;
  }

  /* Ohne drop-shadow, anders als der Peek in „Der Alltag": --shadow-mascot ist
     ein 48px weicher rosa Schein. Auf der Off-White-Fläche dort trägt er, auf
     dem reinen Weiss hier stand ein rosa Schmierfleck um die Figur. */
  .price__wave img {
    display: block;
    width: 196px;
    height: auto;
  }

  .price__plan {
    background: var(--bg-app);
    border: var(--border-hair) solid var(--border-hairline);
    border-radius: var(--radius-2xl);
    padding: clamp(24px, 2.6vw, 36px);
  }

  /* Der empfohlene Plan wird über einen 2px-Rahmen in Schwarz markiert, nicht
     über eine Farbfläche: Schwarz nie als grosse Fläche. */
  .price__plan--featured {
    position: relative;
    border: var(--border-strong) solid var(--pepp-black);
    box-shadow: var(--shadow-2);
  }

  .price__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
  }

  .price__kicker {
    margin-bottom: 0;
  }

  .price__badge {
    display: inline-flex;
    align-items: center;
    height: var(--space-7);
    padding: 0 10px;
    border-radius: var(--radius-pill);
    background: var(--pepp-pink-tint);
    font-size: var(--type-label-size);
    font-weight: var(--weight-semibold);
    color: var(--ink-pink);
  }

  .price__amount {
    margin: var(--space-4) 0 0;
    font-family: var(--font-display);
    font-weight: var(--weight-bold);
    font-size: var(--type-mkt-price);
    line-height: 1;
    letter-spacing: var(--tracking-tight);
    color: var(--text-primary);
  }

  .price__meta {
    margin: var(--space-3) 0 0;
    font-size: var(--type-body-size);
    line-height: var(--type-body-lh);
    color: var(--text-secondary);
  }

  .price__list {
    margin-top: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .price__list li {
    display: flex;
    gap: 10px;
    font-size: var(--type-body-size);
    line-height: var(--type-body-lh);
    color: var(--text-secondary);
  }

  .price__plan--featured :global([data-cta]) {
    margin-top: var(--space-7);
  }

  .price__fine {
    margin: var(--space-4) 0 0;
    font-size: 13px;
    line-height: 18px;
    color: var(--text-secondary);
  }

  .price__trust {
    margin: clamp(24px, 3vw, 32px) 0 0;
    font-size: 14px;
    font-weight: var(--weight-medium);
    color: var(--text-secondary);
  }
</style>
