---
/* Sektion 9 · Der Pott
   Weiss mit Radius oben. Zwei Screens überlappend, unten angeschnitten.
   Die Icons stehen in --pepp-gold: der Pott ist die Auszahlungs-Farbe des
   Design Systems (--status-payout). */
import { Image } from 'astro:assets';
import Icon from '../Icon.astro';
import Blob from '../Blob.astro';

import BlobFeld from '../BlobFeld.astro';

import pott from '../../assets/screens/kind-01-start-taschengeld.png';
import sparziel from '../../assets/screens/kind-12-sparziel.png';

/* Die Sektion redet den Elternteil an und spricht über SEIN Kind. Bis
   01.09.2026 stand hier zweimal die dritte Person — „das Kind knackt selbst"
   und ein Fortschritt, „den man sieht". Beides beschrieb irgendein Kind und
   irgendeinen Betrachter; gelesen wird die Seite aber von jemandem, der ein
   bestimmtes Kind im Kopf hat. Geduzt wird weiterhin nur der Elternteil, nie
   das Kind — die Seite spricht über es, nicht zu ihm.

   Im zweiten Punkt stand ein Lego-Rennwagen für 20,00 € als Sparziel. Der
   Kunde will kein Produktbeispiel; übrig bleibt das Sparziel selbst. */
const points = [
  {
    icon: 'coins',
    lead: 'Verdient statt geschenkt.',
    body: '12,50 € im Pott sind vier erledigte Quests.',
  },
  {
    icon: 'target',
    lead: 'Sparziel mit Bild.',
    body: 'Dein Kind sieht, worauf es hinspart.',
  },
  {
    icon: 'hand-coins',
    lead: 'Dein Kind knackt selbst.',
    body: 'Bar auf die Hand, aufs Sparkonto oder ein Wunsch — du bestätigst.',
  },
];
---

<section class="pot mkt-section mkt-section--card">
  {/* Weiss. Oben rechts, hinter den beiden Geräten. */}
  {/* Von Liam im Blob-Editor gesetzt. */}
  <BlobFeld>
    <Blob
      form="blob2"
      groesse="880px"
      top="-42.8%"
      right="62.1%"
      deckkraft={0.51}
      weichzeichnen={64}
      winkel={235}
      weg={-60}
    />
    <Blob
      ton="pink"
      groesse="1800px"
      top="24.1%"
      left="11%"
      deckkraft={0.49}
      weg={-60}
    />
    <Blob
      ton="peach"
      groesse="800px"
      top="-32.7%"
      left="110.1%"
      deckkraft={0.26}
      weg={-60}
    />
  </BlobFeld>

  <div class="mkt-container pot__inner">
    <div class="pot__grid">
      <div>
        <p class="mkt-label" data-anim>Der Pott</p>
        <h2 class="mkt-h2 mkt-h2--sm" data-anim>Warten wird sichtbar.</h2>
        <p class="mkt-lead pot__lead" data-anim>
          Jede Belohnung, die du freigibst, füllt den Ring um Pepp. Kein Zahlenkonto,
          sondern ein Fortschritt, den dein Kind sieht.
        </p>

        <ul class="pot__points mkt-list-reset">
          {
            points.map((point) => (
              <li data-anim>
                {/* --ink-gold statt --pepp-gold: #F3B53C erreicht auf Weiß nur
                    1,65:1 und ist damit praktisch unsichtbar. --ink-gold ist
                    derselbe Hue abgedunkelt, 3,9:1 — das ist genau der Zweck,
                    für den die --ink-*-Tokens angelegt wurden. */}
                <Icon name={point.icon} size={24} color="var(--ink-gold)" />
                <span>
                  <strong>{point.lead}</strong> {point.body}
                </span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="pot__stage mkt-fade-edges" data-anim="card">
        <Image
          src={pott}
          alt="Pepp Kinder-App: der Pott ist zu 63 Prozent voll, 12,50 € gesammelt"
          width={320}
          height={692}
          densities={[1, 2]}
          format="webp"
          loading="lazy"
          class="pot__screen pot__screen--front"
        />
        <Image
          src={sparziel}
          alt="Pepp Kinder-App: Sparziel anlegen mit Bild, Name und Zielbetrag"
          width={280}
          height={606}
          densities={[1, 2]}
          format="webp"
          loading="lazy"
          class="pot__screen pot__screen--back"
        />
      </div>
    </div>
  </div>
</section>

<style>
  .pot {
    position: relative;
    overflow: hidden;
  }

  .pot__inner {
    position: relative;
  }

  .pot__grid {
    display: grid;
    /* minmax(0,1fr): die Bühne ist 512px breit (320 + 280 - 88 Überlappung)
       und würde die Spalte sonst über den Viewport hinausziehen. */
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(32px, 5vw, 64px);
    align-items: center;
  }

  .pot__lead {
    margin-top: var(--space-5);
    font-size: var(--type-bodyl-size);
    line-height: var(--type-bodyl-lh);
  }

  .pot__points {
    margin-top: clamp(24px, 3vw, 32px);
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .pot__points li {
    display: flex;
    gap: 14px;
  }

  .pot__points span {
    font-size: var(--type-body-size);
    line-height: var(--type-body-lh);
    color: var(--text-secondary);
    max-width: 40ch;
  }

  .pot__points strong {
    color: var(--text-primary);
    font-weight: var(--weight-semibold);
  }

  /* Weiche Kante unten (.mkt-fade-edges) statt gerader Schnittlinie durch
     beide Geräte. */
  .pot__stage {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: flex-start;
    height: clamp(380px, 42vw, 560px);
    overflow: hidden;
    --fade-b: 80%;
  }

  .pot__screen {
    display: block;
    position: relative;
  }

  /* Die Bühne ist 512px breit: 320 (vorn) + 280 (hinten) − 88 (Überlappung).
     Mit festen Pixelmaßen und justify-content:center schnitt overflow:hidden
     bei schmalem Viewport links und rechts je (512 − Bühnenbreite) / 2 ab —
     bei 320px Viewport also 116px je Seite, mitten durch beide Geräte. Vom
     Inhalt blieben Fragmente wie „nma", „IGELD" und „ARZIEL" stehen.

     Deshalb prozentual statt fest. Die drei Werte sind aus dem Entwurf
     abgeleitet und halten dessen Verhältnisse exakt ein:
       vorn        320 / 512 = 62,5 %
       hinten      280 / 512 = 54,69 %
       Überlappung  88 / 512 = 17,19 %
     Bis 512px Bühnenbreite greift der Prozentwert, darüber der Pixelwert —
     das Gerät wird also nie größer als im Entwurf, nur bei Bedarf kleiner.

     Bei den negativen Margins ist es max() und nicht min(): gesucht ist der
     betragsmäßig kleinere Wert, und der ist bei negativen Zahlen der größere.

     height:auto statt fester Höhe, damit das Seitenverhältnis mitläuft. Die
     width/height-Attribute am <Image> bleiben und tragen weiterhin das
     Seitenverhältnis für die Layoutreservierung — kein CLS.

     Behebt Fund 15 aus docs/AUDIT-2026-08-17.md. */
  .pot__screen--front {
    z-index: 2;
    width: min(320px, 62.5%);
    height: auto;
    filter: drop-shadow(0 18px 40px rgb(26 26 26 / 0.16));
  }

  .pot__screen--back {
    z-index: 1;
    width: min(280px, 54.69%);
    height: auto;
    margin-left: max(-88px, -17.19%);
    margin-top: min(56px, 10.94%);
    filter: drop-shadow(0 16px 32px rgb(26 26 26 / 0.12));
  }

  @media (min-width: 901px) {
    .pot__grid {
      grid-template-columns: repeat(auto-fit, minmax(min(360px, 100%), 1fr));
    }
  }
</style>
