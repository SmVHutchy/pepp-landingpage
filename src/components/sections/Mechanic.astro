---
/* Sektion 7 · Die Quest-Mechanik
   Weiss mit Hairline oben, ohne Radius. Der Screen bleibt links sticky stehen
   und wechselt, während rechts die Schritte durchlaufen — der Tausch selbst
   liegt in initMechanicSwap() und läuft nur ab --mkt-breakpoint-desk. */
import { Image } from 'astro:assets';
import Icon from '../Icon.astro';

import anlegen from '../../assets/screens/eltern-06-anlegen-details.png';
import quests from '../../assets/screens/eltern-03-quests.png';
import questListe from '../../assets/screens/kind-03-quest-liste.png';
import Blob from '../Blob.astro';
import BlobFeld from '../BlobFeld.astro';

/* Schritt 3 zeigt in der Referenz `eltern-07-pruefen.png`. Diese Datei ist
   weder im Design-Bundle noch in der Dateiliste des Design-Projekts enthalten
   — auch die Referenz selbst kann sie nicht laden. Solange sie fehlt, bleibt
   der Screen auf dem vorherigen Bild stehen: kein Platzhalter, keine
   Ersatzgrafik. Sobald die Datei in src/assets/screens/ liegt, hier eintragen. */
/* `lead` und `body` sind der Wortlaut aus dem Handoff, nur am Satzende
   getrennt: der erste Satz steht in --text-primary semibold, der Rest in
   --text-secondary. Gleiche Größe, gleicher Absatz, kein Wort geändert. Diese
   Sektion trug mit 582 Zeichen Kartenkörper die dichteste Textmenge der Seite;
   nach der Trennung liest man vier kurze Aussagen statt vier Absätze.
   Das Muster steht schon in Pot.astro (Zeile 126-129). */
const steps = [
  {
    icon: 'list-checks',
    tint: 'var(--pepp-peach-tint)',
    ink: 'var(--ink-peach)',
    screen: anlegen,
    alt: 'Pepp Eltern-App: Quest anlegen mit Belohnung, Wochentagen, Frist und Nachweisart',
    title: 'Kategorie, Belohnung, Frist',
    lead: 'Sieben Kategorien mit Schnellauswahl: Haushalt, Schule, Haustiere, Draußen, Routinen, Medienzeit, Sparen.',
    body: 'Dann 2,50 € oder 30 Min dranhängen — und eine Frist setzen.',
  },
  {
    icon: 'repeat',
    tint: 'var(--pepp-lilac-tint)',
    ink: 'var(--ink-lilac)',
    screen: quests,
    alt: 'Pepp Eltern-App: Quest-Übersicht nach Zustand gruppiert',
    title: 'Einmalig, wiederkehrend, Routine',
    lead: 'Der Müll jeden Dienstag, Hausaufgaben als Routine, Rasen mähen einmal.',
    body: 'Die Liste sortierst du nach Kind und Zustand.',
  },
  {
    icon: 'camera',
    tint: 'var(--pepp-blue-tint)',
    ink: 'var(--ink-blue)',
    screen: null, // eltern-07-pruefen.png fehlt
    title: 'Prüfen als Kartenstapel',
    lead: 'Foto oder Antippen als Nachweis — du entscheidest pro Quest.',
    body: 'Beweise liegen als Stapel bereit: rechts wischen gibt frei, links schickt zurück.',
  },
  {
    icon: 'users',
    tint: 'var(--pepp-pink-tint)',
    ink: 'var(--ink-pink)',
    screen: questListe,
    alt: 'Pepp Kinder-App: Quest-Liste nach Dringlichkeit',
    title: 'Zurückschicken, ohne von vorn',
    lead: 'Beweis unscharf? Zurückschicken heißt nicht neu machen — das Kind liefert nur den Nachweis nach.',
    body: 'Und eine „Für alle"-Quest gehört dem Kind, das zuerst annimmt.',
  },
];

/* Die Screens liegen als Stapel im Markup, einer pro eindeutigem Bild, und der
   Tausch blendet nur noch Deckkraft um. Vorher hing EIN <img> da, dessen src
   beim Scrollen umgeschrieben wurde — daran hingen drei Fehler:

   1. Ein src-Tausch braucht erst eine Ausblendung, sonst springt der Inhalt
      hart um. Die Ausblendung kam nie bei 0 an (gemessen: 0,23), weil das
      CSS `transition: opacity` gegen den GSAP-Tween lief. Sichtbar war ein
      Inhaltssprung in einem halbdurchsichtigen Bild — matschig und überlappt.
   2. Bei jedem Tausch musste srcset mitgesetzt werden, sonst gewann das alte
      srcset gegen das neue src (das war Fund 14). Ein Stapel hat das Problem
      gar nicht: jede Ebene trägt ihr eigenes, unverändertes srcset.
   3. Ein unterbrochener Tausch konnte das Bild halbdurchsichtig stehen lassen.

   Ein Stapel kennt keinen Zwischenzustand ohne Bild: die neue Ebene legt sich
   deckend über die alte, es gibt nichts auszublenden.

   `layerOf` bildet Schritt -> Ebene ab. Schritt 3 hat kein eigenes Bild
   (eltern-07-pruefen.png fehlt, siehe oben) und zeigt deshalb ausdrücklich
   weiter die Ebene von Schritt 2, statt still auszufallen. Sobald die Datei
   da ist, reicht `screen:` — die Ebene entsteht dann von selbst. */
const layers: { screen: ImageMetadata; alt: string }[] = [];
const layerOf = steps.map((step) => {
  if (!step.screen) return Math.max(0, layers.length - 1);
  const vorhanden = layers.findIndex((l) => l.screen === step.screen);
  if (vorhanden !== -1) return vorhanden;
  layers.push({ screen: step.screen, alt: step.alt });
  return layers.length - 1;
});
---

{/* XL-Padding: eine der drei Sektionen, die das Argument tragen. */}
<section class="mech mkt-section mkt-section--xl">
  {/* Weiss. Unten links, gegenüber der Gerätebühne rechts. */}
  {/* Von Liam im Blob-Editor gesetzt. */}
  <BlobFeld>
    <Blob
      ton="peach"
      groesse="1580px"
      top="-1.4%"
      left="26.3%"
      deckkraft={0.26}
      weg={-60}
    />
  </BlobFeld>

  <div class="mkt-container">
    <div class="mkt-head">
      <p class="mkt-label" data-anim>Die Mechanik</p>
      <h2 class="mkt-h2" data-anim>Eine Quest kann viel &#8212; muss aber nichts.</h2>
      <p class="mkt-lead mech__lead" data-anim>
        Kind, Kategorie, Belohnung, Frist. Alles andere ist optional.
      </p>
    </div>

    <div class="mech__grid">
      <div class="mech__sticky">
        <div class="mech__stage">
          <div class="mech__stack" data-mech-stack>
            {
              layers.map((layer, i) => (
                <div class="mech__slide" data-mech-layer={i}>
                  <Image
                    src={layer.screen}
                    alt={layer.alt}
                    width={320}
                    height={692}
                    densities={[1, 2]}
                    format="webp"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
              ))
            }
          </div>
        </div>
      </div>

      <ol class="mech__steps mkt-list-reset">
        {
          steps.map((step, i) => (
            <li data-anim="card" data-mech-step={layerOf[i]}>
              <span class="mech__tile" style={`background:${step.tint}`}>
                <Icon name={step.icon} size={22} color={step.ink} />
              </span>
              <div>
                <h3 class="mech__step-title">{step.title}</h3>
                <p class="mech__step-body">
                  <strong>{step.lead}</strong> {step.body}
                </p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .mech {
    background: var(--surface-card);
    border-top: var(--border-hair) solid var(--border-hairline);
  }

  /* Kein margin-top: der Abstand kommt aus dem gap von .mkt-head. */
  .mech__lead {
    font-size: var(--type-bodyl-size);
    line-height: var(--type-bodyl-lh);
  }

  .mech__grid {
    display: grid;
    /* minmax(0,1fr): der Screen ist 320px breit und würde die Spalte sonst
       über den Viewport hinaus aufziehen. */
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(32px, 5vw, 64px);
    margin-top: clamp(32px, 4vw, 64px);
    align-items: start;
  }

  .mech__sticky {
    position: relative;
  }

  /* Kein `position: sticky` mehr. Seit die Sektion die Seite anhält (Pin in
     initMechanicCarousel), steht der ganze Inhalt still — eine haftende Bühne
     innerhalb eines festgehaltenen Blocks wäre ein zweiter Versatz auf einem,
     der schon steht. Ohne JavaScript scrollt die Sektion durch wie jede
     andere; das war auch mit sticky so. */
  .mech__stage {
    display: flex;
    justify-content: center;
  }

  /* perspective macht aus dem rotationY der Karussell-Bewegung eine echte
     Drehung im Raum statt einer Stauchung. Der Wert ist bewusst hoch: bei
     kleinerer Perspektive kippt das Gerät so stark, dass die Screens am Rand
     verzerren. */
  .mech__stack {
    position: relative;
    width: 320px;
    height: 692px;
    perspective: 1400px;
  }

  /* Eine Ebene des Karussells. Transform, Deckkraft und Weichzeichner setzt
     ausschliesslich GSAP (siehe initMechanicCarousel in site.js) — hier steht
     nur, was ohne Skript gelten soll.

     KEIN transition auf opacity oder filter. GSAP schreibt diese Werte Bild
     für Bild selbst; eine CSS-Transition startet bei jedem dieser
     Schreibvorgänge neu und hängt dem Tween hinterher. Vorher stand hier eine
     — gemessen kam die Ausblendung nie unter 0,23 Deckkraft, und der neue
     Screen erschien im noch zu einem Viertel sichtbaren alten. Das war das
     Matschige und Überlappende. */
  .mech__slide {
    position: absolute;
    inset: 0;
    /* Nur auf Elementen, die sich wirklich bewegen. */
    will-change: transform, opacity;
  }

  .mech__slide img {
    width: 320px;
    height: 692px;
    display: block;
    filter: drop-shadow(0 18px 40px rgb(26 26 26 / 0.16));
  }

  /* Ohne Skript liegen alle drei Ebenen deckungsgleich aufeinander. Das ist
     kein Problem, sondern der Ruhezustand: die Geräte sind gleich gross und
     deckend, es ist also genau eines zu sehen. Der z-index bestimmt nur,
     WELCHES — ohne diese zwei Regeln wäre es das letzte im Markup.

     Ausdrücklich kein `opacity: 0` hier. Startzustände von Animationen gehören
     ins Skript, sonst verschwindet Inhalt, sobald das Skript ausfällt;
     scripts/verify.mjs prüft das und hat einen ersten Versuch an dieser Stelle
     zu Recht abgelehnt. */
  .mech__slide {
    z-index: 0;
  }

  .mech__slide:first-child {
    z-index: 1;
  }

  .mech__steps {
    display: flex;
    flex-direction: column;
    gap: clamp(24px, 3vw, 40px);
  }

  .mech__steps li {
    display: flex;
    gap: var(--space-5);
  }

  .mech__tile {
    width: 44px;
    height: 44px;
    flex: 0 0 auto;
    border-radius: var(--radius-lg);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .mech__step-title {
    font-family: var(--font-display);
    font-weight: var(--weight-bold);
    font-size: clamp(20px, 1.8vw, 24px);
    line-height: 1.25;
    margin: 0;
    color: var(--text-primary);
  }

  .mech__step-body {
    margin: var(--space-3) 0 0;
    font-size: var(--type-body-size);
    line-height: var(--type-body-lh);
    color: var(--text-secondary);
    max-width: var(--measure-body);
  }

  /* Nur Farbe und Gewicht, ausdrücklich keine Größe: 17px für den ersten Satz
     plus 15px für den Rest kostet in dieser Sektion +58px pro Schritt. */
  .mech__step-body strong {
    color: var(--text-primary);
    font-weight: var(--weight-semibold);
  }

  /* Ab Desktop steht der Screen neben den Schritten und bleibt sticky.
     Darunter faellt er ganz weg: ein 320px-Bild, das viermal dasselbe zeigt,
     kostet auf Mobil nur Hoehe und Datenvolumen. */
  @media (min-width: 901px) {
    .mech__grid {
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1fr);
    }
  }

  @media (max-width: 900px) {
    .mech__sticky {
      display: none;
    }
  }
</style>
