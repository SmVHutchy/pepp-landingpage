---
/* Sektion 15 · Footer
   Weiss mit Hairline oben. Die Rechtslinks zeigen auf eigene Seiten dieser
   Domain — in der Design-Referenz gingen sie noch auf taschengeldapp.com.

   Die Store-Links im Footer nutzen die offiziellen App-Store- und
   Google-Play-Badges (lokalisiert auf Deutsch). Sie sind sekundär zum
   einzigen Primär-CTA, der schwarz bleibt und immer denselben Text trägt. */
import { STORE, OPERATOR } from '../../data/site.js';

/* Die Rechtszeile wird hier zusammengesetzt und NICHT im Markup aus mehreren
   Ausdrücken, zwischen denen ein Zeilenumbruch steht. Genau das stand hier
   vorher, und Astro 7 hat die Umbrüche weggekürzt: ausgeliefert wurde
   „GmbH ·Hans-Vogel-Straße 59, 90765Fürth". Unter Astro 5 trug der Umbruch
   noch ein Leerzeichen, hier hing also eine sichtbare Ausgabe an der
   Quelltextformatierung. Als eine Zeichenkette kann weder der Compiler noch
   ein Prettier-Umbruch etwas daran verschieben. */
const rechtszeile = [
  `© ${OPERATOR.copyrightYear} Pepp`,
  OPERATOR.legalName,
  `${OPERATOR.street}, ${OPERATOR.postalCode} ${OPERATOR.city}`,
].join(' · ');

const product = [
  { href: '/#funktionen', label: 'Funktionen' },
  { href: '/#belohnungen', label: 'Belohnungen' },
  { href: '/#preis', label: 'Preis' },
  { href: '/#faq', label: 'FAQ' },
];

const legal = [
  { href: '/impressum', label: 'Impressum' },
  { href: '/datenschutz', label: 'Datenschutz' },
  { href: '/agb', label: 'AGB' },
  { href: '/barrierefreiheit', label: 'Barrierefreiheit' },
];
---

<footer class="foot">
  <div class="foot__grid">
    <div>
      <a href="/" class="foot__brand" aria-label="Pepp — zur Startseite">
        <img
          src="/logo/pepp-wortbildmarke.svg"
          alt="Pepp"
          width="3000"
          height="1143"
          loading="lazy"
        />
      </a>
      <p class="foot__claim">Die Familien-App, in der aus Aufgaben Quests werden.</p>
    </div>

    <nav aria-label="Footer-Navigation">
      <p class="mkt-label foot__head">Produkt</p>
      <ul class="foot__links mkt-list-reset">
        {
          product.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <nav aria-label="Rechtliches">
      <p class="mkt-label foot__head">Rechtliches</p>
      <ul class="foot__links mkt-list-reset">
        {
          legal.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div>
      <p class="mkt-label foot__head">App laden</p>
      <div class="foot__stores">
        <a href={STORE.ios} class="foot__store" aria-label="Laden im App Store">
          <img
            src="/badges/app-store-de.svg"
            alt="Laden im App Store"
            width="120"
            height="40"
            loading="lazy"
          />
        </a>
        <a
          href={STORE.android}
          class="foot__store foot__store--play"
          aria-label="Jetzt bei Google Play"
        >
          <img
            src="/badges/google-play-de.png"
            alt="Jetzt bei Google Play"
            width="646"
            height="250"
            loading="lazy"
          />
        </a>
      </div>
    </div>
  </div>

  <div class="foot__legal">
    <p>{rechtszeile}</p>
    <p class="foot__trademarks">
      Apple und das Apple Logo sind Marken von Apple Inc. App Store ist eine
      Dienstleistungsmarke von Apple Inc. Google Play und das Google Play Logo sind
      Marken von Google LLC.
    </p>
  </div>
</footer>

<style>
  .foot {
    background: var(--surface-card);
    border-top: var(--border-hair) solid var(--border-hairline);
    padding: clamp(48px, 6vw, 72px) 0 clamp(32px, 4vw, 48px);
  }

  .foot__grid {
    max-width: var(--mkt-content-width);
    margin-inline: auto;
    padding-inline: var(--mkt-gutter);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr));
    gap: clamp(32px, 4vw, 48px);
  }

  /* Eine Wort-Bild-Marke statt zwei Bildern, siehe Nav.astro. */
  .foot__brand {
    display: flex;
    align-items: center;
  }

  .foot__brand img {
    display: block;
    width: 114px;
    height: auto;
  }

  .foot__claim {
    margin: var(--space-5) 0 0;
    font-size: var(--type-body-size);
    line-height: var(--type-body-lh);
    color: var(--text-secondary);
    max-width: 32ch;
  }

  .foot__head {
    margin-bottom: var(--space-4);
  }

  .foot__links {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .foot__links a {
    font-size: var(--type-body-size);
    font-weight: var(--weight-medium);
    color: var(--text-secondary);
    text-decoration: none;
  }

  .foot__links a:hover {
    color: var(--pepp-ink);
  }

  .foot__stores {
    display: flex;
    flex-direction: column;
    gap: 10px;
    align-items: flex-start;
  }

  .foot__store {
    display: block;
    line-height: 0;
    text-decoration: none;
  }

  .foot__store img {
    display: block;
    width: auto;
    height: 40px;
  }

  /* Googles Originalgrafik bringt 29px Freiraum oben und unten mit, Apples
     nicht. 52px Kastenhöhe ergibt 39,9px sichtbaren Knopf und trifft damit
     Apples 40. Ausführlich in Hero.astro und public/badges/HERKUNFT.md.
     Hier stapelt die Reihe untereinander, align-items ist deshalb ohne
     Wirkung — die Kästen stehen links auf Kante. */
  .foot__store--play img {
    height: 52px;
  }

  .foot__legal {
    max-width: var(--mkt-content-width);
    margin: clamp(32px, 4vw, 48px) auto 0;
    padding: var(--space-7) var(--mkt-gutter) 0;
    border-top: var(--border-hair) solid var(--border-hairline);
  }

  .foot__legal p {
    margin: 0;
    font-size: 13px;
    line-height: 20px;
    color: var(--text-secondary);
  }

  /* Die einzige Stelle der Seite, an der Fließtext keine Zeilenlängenbremse
     erbte: der Markenhinweis lief bei 1440px über 1099px auf einer einzigen
     Zeile, gemessen 134 Zeichen. WCAG 1.4.8 nennt 80 als Obergrenze — dieselbe
     Grenze, die im FAQ schon zitiert ist. --measure-body (42ch) wäre hier
     falsch: das ist das Maß für Lesetext in Bodygröße, bei 11px Kleingedrucktem
     ergäbe es sechs Zeilen. 80ch statt eines px-Werts, damit die Grenze in
     Zeichen steht und nicht in einer Breite, die von der Schrift abhängt.
     Die Zeile über dem Markenhinweis bleibt ohne Bremse: sie ist eine Angabe,
     kein Absatz, und bricht mit 68 Zeichen nie um. */
  .foot__trademarks {
    margin-top: var(--space-3);
    font-size: 11px;
    line-height: 16px;
    max-width: 80ch;
  }
</style>
