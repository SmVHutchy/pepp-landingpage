---
/* Sektion 2 · Hero
   H1 und CTA werden NIE animiert — sie tragen den LCP. Deshalb steht hier
   auch kein data-anim und kein Startzustand.

   Statt zwei angeschnittener App-Screens steht hier das Maskottchen: der
   gelieferte Render pepp-coin-play.png mit Alphakanal, aus dem Character Sheet.
   Nichts nachgezeichnet, nichts umgefärbt.

   Die Pose mit der Münze statt der winkenden: die Münze ist das Zeichen der
   Seite — sie steht im Logo, im Loader hier daneben und in „Geld oder
   Medienzeit". Winken sagt hallo, die Münze sagt worum es geht. pepp-wave
   steht dafür jetzt in der Preis-Sektion, in der Lücke unter der Monatskarte.

   Der Render kam mit rund 240px durchsichtigem Rand (1280x1280 quadratisch).
   Der ist beim Kopieren weggeschnitten — 1043x1167 —, sonst füllt der Rand die
   Bühne mit und die Figur wirkt kleiner, als sie ist.

   Die App-Screens sind damit erst ab „Die Mechanik" zu sehen. Das ist bewusst
   so entschieden: die Startseite zeigt die Marke, nicht das Interface. */
import { Image } from 'astro:assets';
import Blob from '../Blob.astro';
import BlobFeld from '../BlobFeld.astro';
import Cta from '../Cta.astro';
import Icon from '../Icon.astro';

import { STORE } from '../../data/site.js';

import mascot from '../../assets/mascot/pepp-coin-play.png';
import coin from '../../assets/brand/pepp-coin-freigestellt.png';

/* Zwei Vertrauenspunkte direkt im Hero — kurz, sichtbar, nicht
   widersprüchlich zur Security-Sektion. Die finanziellen und datenschutz-
   relevanten Claims (kein Bankkonto, kein Datenverkauf) leben ausführlich in
   Sektion 10, statt hier und dort zu wiederholen. */
const trustPoints = [
  { icon: 'shield-check', label: 'Made in Germany' },
  { icon: 'circle-slash', label: 'Werbefrei' },
];
---

<section class="hero">
  {/* Von Liam im Blob-Editor gesetzt. */}
  <BlobFeld>
    <Blob
      class="hero__blob hero__blob--1"
      form="blob3"
      groesse="1480px"
      top="-17.7%"
      left="36.6%"
      deckkraft={0.23}
      weichzeichnen={64}
      winkel={360}
      weg={0}
    />
    <Blob
      class="hero__blob hero__blob--2"
      ton="pink"
      groesse="1080px"
      top="-7.9%"
      left="108.2%"
      deckkraft={0.36}
      weg={-60}
    />
    <Blob
      class="hero__blob hero__blob--3"
      ton="peach"
      groesse="1510px"
      top="-6.6%"
      left="-9.2%"
      deckkraft={0.75}
      weg={-60}
    />
  </BlobFeld>
  <div class="hero__grid">
    <div class="hero__copy">
      <h1 class="mkt-h1">Taschengeld-App für die ganze Familie</h1>

      <p class="hero__subline">
        Kinder sammeln Rewards. Eltern behalten den Überblick.
      </p>

      <div class="hero__actions">
        <Cta elevated />
        <a class="hero__textlink" href="#funktionen">
          So funktioniert’s
          <Icon name="arrow-right" size={16} />
        </a>
      </div>

      {
        /* Die offiziellen Store-Badges, dieselben wie im Footer. Vorher standen
          hier selbstgebaute Pillen — Icon plus Wortmarke auf Off-White —, damit
          nicht drei schwarze Flächen nebeneinander stehen und der Primär-CTA
          seine Sonderstellung verliert. Der Kunde hat sich aus Markengründen
          gegen den Eigenbau entschieden: Apple und Google geben die Badges vor,
          und zwei Fassungen desselben Knopfes auf einer Seite wären ohnehin ein
          Bruch. Die schwarzen Flächen sind damit gewollt; unterschieden wird
          jetzt über die Form — Pille mit CTA-Text gegen Store-Badge.

          Sie tragen KEIN data-cta. Die Store-Weiche in nav.js schaltet jedes
          [data-cta] auf Android in den Play Store um — hier wäre das falsch:
          das sind zwei benannte Ziele, jedes zeigt auf seinen eigenen Store.

          Sie stehen hier oben statt unten, weil sie an derselben Stelle
          entscheiden wie der CTA. Vorher lag an dieser Stelle ein QR-Code mit
          Erklärzeile am unteren Rand der Spalte — ein Umweg über die Kamera
          für etwas, das auf dem Handy ein Fingertipp ist, und auf dem Desktop
          eine 121px hohe Einheit im ersten Bildschirm.

          loading="eager" statt lazy wie im Footer: die Badges stehen im ersten
          Bildschirm, ein verzögerter Ladestart wäre hier sichtbar. */
      }
      <div class="hero__stores">
        <a href={STORE.ios} class="hero__store" aria-label="Laden im App Store">
          <img
            src="/badges/app-store-de.svg"
            alt="Laden im App Store"
            width="120"
            height="40"
            loading="eager"
          />
        </a>
        <a
          href={STORE.android}
          class="hero__store hero__store--play"
          aria-label="Jetzt bei Google Play"
        >
          <img
            src="/badges/google-play-de.png"
            alt="Jetzt bei Google Play"
            width="646"
            height="250"
            loading="eager"
          />
        </a>
      </div>
    </div>

    <div class="hero__visual">
      {
        /* Der Dawn-Schein liegt HINTER dem Maskottchen, nicht als Fläche:
          er gibt der Figur Grund, ohne selbst Fläche zu werden. */
      }
      <div class="hero__glow" aria-hidden="true"></div>

      <div class="hero__figure" data-hero-figure>
        {
          /* widths + sizes statt densities, und das ist hier kein Feinschliff:
            die Figur ist breitenvariabel (`width: clamp(240px, 40vw, 580px)`
            weiter unten), und sie ist auf dem Handy das LCP-Bild.

            Mit `densities={[1, 2]}` bot der Browser nur 580px und 1043px an.
            Auf einem Retina-Handy ist die Box 240px breit, gebraucht werden
            also 480px — geladen wurde die 1043px-Datei mit 58 kB. Für das
            Bild, auf das die Messung des Largest Contentful Paint zeigt.

            sizes bildet die clamp-Kurve in Media Queries ab, weil clamp() im
            sizes-Attribut noch nicht überall trägt: unter 600px Viewport
            gewinnt der Boden (40vw ≤ 240px), ab 1450px die Decke
            (40vw ≥ 580px), dazwischen gilt 40vw.

            ÄNDERT SICH DIE CLAMP-ZEILE IM CSS, muss sizes mit. Die beiden
            Stellen sind die einzige Kopplung in dieser Datei, deshalb steht
            der Hinweis an beiden. 1043 ist die Breite der Quelldatei —
            grösser hat keinen Zweck. */
        }
        <Image
          src={mascot}
          alt="Pepp, das Sparschwein-Maskottchen, hält eine Goldmünze hoch"
          width={580}
          height={649}
          widths={[240, 360, 480, 580, 760, 1043]}
          sizes="(max-width: 600px) 260px, (min-width: 1450px) 580px, 40vw"
          format="webp"
          loading="eager"
          fetchpriority="high"
          class="hero__mascot"
        />
      </div>

      {
        /* Ladeanzeige. hidden im Markup: ohne JavaScript ist sie NIE da, kann
          also nichts dauerhaft verdecken. Sie liegt neben dem Maskottchen und
          nie über H1 oder CTA — die tragen den LCP. Das Skript zeigt sie erst,
          wenn die Schriften nach 150ms noch nicht stehen, und entfernt sie bei
          document.fonts.ready. */
      }
      <div class="hero__loader" data-loader hidden>
        <Image
          src={coin}
          alt=""
          width={44}
          height={44}
          densities={[1, 2]}
          format="webp"
          loading="eager"
        />
        <span class="hero__loader-text">Pepp wird geladen</span>
      </div>
    </div>
  </div>

  <div class="hero__trustbar">
    <ul class="hero__trustbar-list mkt-list-reset">
      {
        trustPoints.map((point) => (
          <li>
            <Icon name={point.icon} size={20} color="var(--pepp-ink)" />
            {point.label}
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding: clamp(24px, 4vw, 48px) 0 0;
    /* Auf Mobile soll der Hero mindestens den Bereich zwischen Navigation und
       unterem Bildrand füllen, damit die Trust-Bar am unteren Rand klebt. */
    min-height: calc(100svh - var(--height-nav));
    display: flex;
    flex-direction: column;
  }

  .hero__grid {
    flex: 1 0 auto;
  }

  /* Der erste Bildschirm ist eine Einheit: Navigation oben, Hero-Inhalt
     mittig, die weisse Trust-Leiste als Abschlusskante unten.

     min-height, nicht height — auf einem flachen Fenster darf der Inhalt die
     Sektion weiterhin aufziehen, statt gestaucht zu werden.

     svh statt vh: auf iOS ist vh die Höhe MIT eingefahrener Adressleiste. Mit
     ausgefahrener Leiste — also beim Laden — wäre die Sektion damit höher als
     der sichtbare Bereich, und die Trust-Leiste läge unter der Kante, genau in
     dem Moment, in dem sie zu sehen sein soll. */
  @media (min-width: 901px) {
    .hero {
      display: grid;
      /* Inhalt nimmt den verfügbaren Platz, Trust-Leiste sitzt unten. */
      grid-template-rows: 1fr auto;
      /* --border-hair ist die untere Haarlinie der Navigation. */
      min-height: calc(100svh - var(--height-nav) - var(--border-hair));
      padding-block: clamp(24px, 4vw, 48px) 0;
    }

    .hero__grid {
      align-self: center;
    }
  }

  /* Kompakter Modus für Laptops und kleine Desktop-Fenster: der Inhalt soll
     nicht über den verfügbaren Platz hinauswachsen, damit die Trust-Leiste
     unten immer noch im ersten Screen liegt. */
  @media (min-width: 901px) and (max-height: 850px) {
    .hero {
      padding-block: clamp(16px, 2.5vw, 32px);
    }

    .hero__subline {
      margin-top: clamp(12px, 1.5vw, 16px);
    }

    .hero__actions,
    .hero__stores {
      margin-top: clamp(16px, 2vw, 24px);
    }

    /* Nur die Breite wird hier gedeckelt. Ein max-height an dieser Stelle wäre
       wirkungslos: die unbedingte .hero__mascot-Regel weiter unten hat dieselbe
       Spezifität und steht später — eine Medienabfrage erhöht die Spezifität
       nicht. Gemessen bei 1440x800: getComputedStyle(img).maxHeight lieferte
       „576px" aus der unbedingten Regel, nicht den Wert von hier. Die tote
       Zeile ist deshalb raus statt repariert: mit ihr wäre die Figur bei
       1440x800 von 460x514,7 auf 440 Höhe gefallen — eine Stauchung, die es
       heute nicht gibt. Der Höhendeckel steht unten, in der Breite gerechnet. */
    .hero__mascot {
      max-width: 460px;
    }
  }

  .hero__grid {
    position: relative;
    /* width: 100% ist ab 901px nötig, wo .hero ein Grid wird: ein Grid-Item
       mit `margin-inline: auto` wird in dieser Achse nicht gestreckt, die
       Breite fiele auf fit-content. Hier fällt es nicht auf, weil der Inhalt
       die Spalte ohnehin füllt — in der Alltag-Sektion sind aus demselben
       Effekt 1862px Sektionshöhe statt 1080 geworden. Die Zeile steht an
       beiden Stellen; sie kostet unter 901px nichts. */
    width: 100%;
    max-width: var(--mkt-content-width);
    margin-inline: auto;
    padding-inline: var(--mkt-gutter);
    display: grid;
    /* minmax(0,1fr) statt 1fr: die Bühne enthält einen 820px breiten
       Screen-Container. Mit auto-Minimum würde dessen min-content die Spalte
       auf 820px aufziehen und die Copy-Spalte aus dem Viewport schieben —
       der Text wird dann von overflow:hidden abgeschnitten statt umzubrechen
       (Reflow-Verstoss bei 320px). */
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(32px, 5vw, 56px);
    align-items: center;
  }

  @media (min-width: 901px) {
    .hero__grid {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    }
  }

  .hero__copy {
    max-width: 560px;
    padding-bottom: clamp(48px, 6vw, 80px);
  }

  /* Das Polster hat die Spalte gegen die höhere Figur ausgeglichen, solange
     der Hero seine Höhe aus dem Inhalt bezog. Jetzt zentriert das Raster
     beide Spalten im vollen Bildschirm, und dasselbe Polster würde die Copy
     um seine halbe Höhe nach oben ziehen. */
  @media (min-width: 901px) {
    .hero__copy {
      padding-bottom: 0;
    }
  }

  .hero__subline {
    font-family: var(--font-ui);
    font-size: var(--type-mkt-lead);
    line-height: 1.5;
    color: var(--text-secondary);
    margin: clamp(16px, 2vw, 24px) 0 0;
    max-width: var(--measure-body);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-5);
    margin-top: clamp(24px, 3vw, 32px);
  }

  /* min-height ist Berührungsfläche, keine Optik: der Link steht allein neben
     dem CTA, ist also kein Fließtextlink und damit nicht von WCAG 2.5.8
     ausgenommen. Ohne die Zeile war er 22px hoch — unter den 24px der Norm.
     Sichtbar ändert sich nichts, weil .hero__actions den CTA mit 56px daneben
     hat und die Zeile ohnehin höher ist. */
  .hero__textlink {
    font-size: var(--type-body-size);
    font-weight: var(--weight-semibold);
    color: var(--text-secondary);
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    gap: 6px;
  }

  .hero__textlink:hover {
    color: var(--pepp-ink);
  }

  /* Trust-Bar direkt im Hero. Auf Mobile erscheint sie als weisse Leiste am
     unteren Rand der Sektion, auf Desktop als Abschlusskante des ersten
     Screens. */
  .hero__trustbar {
    position: relative;
    z-index: 2;
    border-top: var(--border-hair) solid var(--border-hairline);
    background: var(--surface-card);
  }

  .hero__trustbar-list {
    margin-inline: auto;
    padding: var(--space-6) var(--mkt-gutter);
    max-width: var(--mkt-content-width);
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-5) var(--space-8);
  }

  .hero__trustbar-list li {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: var(--type-body-size);
    font-weight: var(--weight-semibold);
    color: var(--text-secondary);
  }

  @media (max-width: 600px) {
    .hero__trustbar-list {
      justify-content: center;
      gap: var(--space-3) var(--space-5);
      padding: var(--space-4) var(--mkt-gutter);
    }

    .hero__trustbar-list li {
      font-size: 13px;
      gap: 8px;
    }

    .hero__trustbar-list li :global(svg) {
      width: 16px;
      height: 16px;
    }

    .hero__mascot {
      width: clamp(200px, 55vw, 260px);
      max-height: min(32svh, 220px);
    }
  }

  /* Sehr kleine Handys wie iPhone SE (375 × 667): der Inhalt passt nur, wenn
     Polster, Typografie und Figur zusätzlich komprimiert werden. */
  @media (max-width: 600px) and (max-height: 700px) {
    .hero {
      padding-top: var(--space-5);
    }

    .hero__copy {
      padding-bottom: var(--space-6);
    }

    .mkt-h1 {
      font-size: 30px;
    }

    .hero__subline {
      font-size: 15px;
      margin-top: 8px;
    }

    .hero__actions {
      margin-top: 12px;
    }

    .hero__textlink {
      font-size: 14px;
    }

    .hero__stores {
      margin-top: 12px;
    }

    .hero__mascot {
      max-height: min(26svh, 160px);
    }
  }

  /* Masse aus .foot__store im Footer übernommen — es ist dasselbe Badge an
     einer zweiten Stelle, und zwei verschiedene Store-Knöpfe auf einer Seite
     wären ein Bruch. Nur die Richtung ist eine andere: im Footer stehen sie
     untereinander in einer schmalen Spalte, hier nebeneinander unter dem CTA.
     flex-wrap, damit sie bei schmaler Spalte umbrechen statt aus ihr zu
     laufen. */
  .hero__stores {
    display: flex;
    flex-wrap: wrap;
    /* align-items: center, weil die beiden Kästen unterschiedlich hoch sind —
       40px Apple gegen 52px Google, siehe .hero__store--play. Ohne die Zeile
       stünde Apples Badge per stretch auf 52px Zeilenhöhe und wäre 4px zu
       hoch ausgerichtet. */
    align-items: center;
    gap: var(--space-4);
    margin-top: var(--space-6);
  }

  /* Unter 600px nimmt der Hero zu viel auf: CTA, Textlink, Trustbar und
     Maskottchen teilen sich den ersten Screen. Die Store-Buttons sind im
     Footer und in der Sticky-Leiste erreichbar, deshalb fallen sie hier raus. */
  @media (max-width: 600px) {
    .hero__stores {
      display: none;
    }
  }

  .hero__store {
    display: block;
    /* Das Badge ist ein Inline-Bild in einem Link: ohne line-height:0 zieht
       der Zeilenkasten den Link ein paar Pixel höher als das Bild. */
    line-height: 0;
    text-decoration: none;
  }

  .hero__store img {
    display: block;
    width: auto;
    height: 40px;
  }

  /* 52px, nicht 40 — und das ist kein grösseres Badge, sondern ein gleich
     grosses. Googles Originalgrafik liefert ihren Freiraum mit: von 250px
     Dateihöhe sind 646x192 sichtbarer Knopf, oben und unten je 29px
     transparent (gemessen mit sharp über den Alphakanal). Apple füllt seine
     Zeichenfläche dagegen ganz aus.

     Bei gleicher Kastenhöhe wäre Googles Knopf 40 x 0,768 = 30,7px hoch gegen
     Apples 40 — sichtbar kleiner. 52 x 0,768 = 39,9px trifft Apple. Die 6px
     Überstand nach oben und unten sind transparent, die Reihe zentriert.

     Der Freiraum wegzuschneiden wäre der naheliegende Weg und zugleich eine
     Veränderung der Marke, die beide Richtlinien untersagen.
     Siehe public/badges/HERKUNFT.md. */
  .hero__store--play img {
    height: 52px;
  }

  .hero__visual {
    position: relative;
    width: 100%;
    display: grid;
    place-items: center;
  }

  /* --glow-peach ist ein radialer closest-side-Verlauf und im Design System
     genau für den Maskottchen-Schein angelegt. Er lief bisher ungenutzt mit.
     Radial statt Rechteck-mit-Blur: kein Radius, kein filter, und damit auch
     keine sichtbare Kante, wie sie mein erster Versuch hatte. */
  .hero__glow {
    position: absolute;
    inset: -10%;
    background: var(--glow-peach);
    pointer-events: none;
  }

  .hero__figure {
    position: relative;
    width: 100%;
    display: flex;
    justify-content: center;
  }

  /* Feste Breite über clamp und aspect-ratio aus width/height am <Image>:
     die Höhe steht damit vor dem Laden und CLS bleibt 0. */
  .hero__mascot {
    /* Der Höhendeckel steht als eigener Wert, weil er an zwei Stellen
       gebraucht wird: als Breitendeckel über das Seitenverhältnis und als
       max-height. Die max-height greift nie — die Breite hält die Höhe schon
       darunter —, aber sie ist die Zeile, die die schwächeren
       .hero__mascot-Regeln in den Medienblöcken weiter oben überschreibt.
       Fällt sie weg, werden deren max-height wieder wirksam und stauchen die
       Figur auf dem Handy (gemessen 390x844: 240x220 statt 240x268,7). */
    --mascot-cap-h: min(72svh, 580px);
    /* Grösser als der Vorgänger (34vw/520px): auf 1440px sind das bis zu 576
       statt 490 Pixel. Die Bühnenspalte ist rund 517px breit, die Figur ragt
       also darüber hinaus — in die Spalten-Lücke, nicht in die Copy. Die
       Sektion hat overflow:hidden, mehr braucht es nicht.

       Der zweite Term ist der Höhendeckel, in der Breite gerechnet: 580/649
       ist das Seitenverhältnis aus den width/height-Attributen des <Image>
       oben. Als max-height notiert war der Deckel eine Stauchung — die Breite
       steht durch clamp fest, height:auto löst über das Verhältnis auf, und
       max-height kürzt danach nur die Höhe, ohne die Breite nachzuziehen.
       Gemessen bei 1440x900: 576x580 statt 576x644,5, also 9,9 % gestaucht,
       und ohne object-fit malt das <img> mit fill statt zu letterboxen. Als
       Breitendeckel greift derselbe Wert, ohne das Verhältnis zu brechen:
       518,4x580 bei 1440x900. Die Höhe ist damit weiterhin bei min(72svh,
       580px) gedeckelt und drückt die Copy nicht nach oben.

       DIESE ZEILE IST AN DAS sizes-ATTRIBUT DES <Image> OBEN GEKOPPELT.
       Ändert sich der Boden (240px), die Steigung (40vw) oder die Decke
       (580px), lädt der Browser sonst die falsche Auflösung. Der Höhendeckel
       braucht dort nichts: er macht die Box nur schmaler als 40vw, sizes
       überschätzt dann höchstens — geladen wird bei 1440x900 wie vorher die
       580px-Fassung. */
    width: min(clamp(240px, 40vw, 580px), calc(var(--mascot-cap-h) * 580 / 649));
    height: auto;
    max-height: var(--mascot-cap-h);
    display: block;
    /* --shadow-mascot ist im Design System genau dieser Wert. Ich hatte ihn
       zuerst als Literal hingeschrieben — das war ein Doppel des Tokens und
       die einzige Hex-Angabe im Markup. */
    filter: drop-shadow(var(--shadow-mascot));
  }

  .hero__loader {
    position: absolute;
    right: 0;
    bottom: 0;
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-3) var(--space-5) var(--space-3) var(--space-3);
    border-radius: var(--radius-pill);
    background: var(--surface-card);
    border: var(--border-hair) solid var(--border-hairline);
    box-shadow: var(--shadow-1);
  }

  .hero__loader[hidden] {
    display: none;
  }

  .hero__loader img {
    width: 44px;
    height: 44px;
    display: block;
  }

  .hero__loader-text {
    font-size: 14px;
    font-weight: var(--weight-semibold);
    color: var(--text-secondary);
  }

  /* Die Münze dreht sich um die eigene Achse — ein Sparschwein-Loader statt
     eines Standard-Spinners. Kein Blinken, kein Pulsieren der Fläche: nur die
     Münze bewegt sich, der Text steht still und bleibt lesbar. */
  @keyframes pepp-coin-spin {
    from {
      transform: rotateY(0deg);
    }
    to {
      transform: rotateY(360deg);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero__loader img {
      animation: pepp-coin-spin var(--dur-coin-spin) linear infinite;
    }
  }
  /* Langsame Hintergrundbewegung der drei Hero-Blobs. Jeder Blob schwebt in
     einer eigenen Bahn, damit die Fläche nicht wie ein starres Bild wirkt.
     Die Werte sind bewusst subtil — der Effekt soll störungsfrei im
     Hintergrund bleiben, nicht ins Auge springen. */
  @media (prefers-reduced-motion: no-preference) and (min-width: 601px) {
    .hero__blob {
      animation: blob-float var(--dur-blob-float, 18s) ease-in-out infinite alternate;
    }

