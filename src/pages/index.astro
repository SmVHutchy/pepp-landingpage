---
import Base from '../layouts/Base.astro';
import Nav from '../components/sections/Nav.astro';
import Hero from '../components/sections/Hero.astro';
import TrustBar from '../components/sections/TrustBar.astro';
import Problem from '../components/sections/Problem.astro';
import HowItWorks from '../components/sections/HowItWorks.astro';
import Rewards from '../components/sections/Rewards.astro';
import Mechanic from '../components/sections/Mechanic.astro';
import Modes from '../components/sections/Modes.astro';
import Pot from '../components/sections/Pot.astro';
import Security from '../components/sections/Security.astro';
import Family from '../components/sections/Family.astro';
import SocialProof from '../components/sections/SocialProof.astro';
import Pricing from '../components/sections/Pricing.astro';
import Faq from '../components/sections/Faq.astro';
import FinalCta from '../components/sections/FinalCta.astro';
import Footer from '../components/sections/Footer.astro';
import StickyCta from '../components/sections/StickyCta.astro';
import { getImage } from 'astro:assets';
import { PRICING, SITE, STORE } from '../data/site.js';
import { FAQ } from '../data/faq.js';
import elternQuests from '../assets/screens/eltern-03-quests.png';
import kindStart from '../assets/screens/kind-01-start-taschengeld.png';

/* Strukturierte Daten serverseitig — nicht per JS aus dem DOM gebaut.
   Preise kommen aus PRICING, die FAQ aus derselben Liste wie Sektion 13.

   WebSite und Organization stehen NICHT hier, sondern in Base.astro: sie
   gelten für jede Seite. Was hier steht, gilt nur für die Startseite, und es
   verweist über @id auf die Objekte dort, statt Name und Adresse ein zweites
   Mal zu führen. Beides landet in einem gemeinsamen @graph — erst dadurch
   sieht ein Parser, dass die BlueBranch GmbH die Herausgeberin dieser App ist
   und die FAQ zu dieser Website gehört.

   applicationCategory bleibt FinanceApplication, obwohl Pepp kein
   Finanzprodukt ist (scripts/verify.mjs:94 prüft genau diese Abgrenzung im
   sichtbaren Text). Die schema.org-Liste kennt keine passendere Kategorie;
   die Abgrenzung leistet die description, nicht der Kategorieschlüssel. */
/* screenshot verlangt fertige URLs. getImage() erzeugt dieselben WebP, die
   <Image> in den Sektionen ausliefert — es entsteht also keine dritte Datei,
   nur ein Verweis auf die, die ohnehin gebaut wird. Je ein Screen pro Welt. */
const [screenEltern, screenKind] = await Promise.all(
  [elternQuests, kindStart].map((src) => getImage({ src, format: 'webp' }))
);

const jsonLd = [
  {
    '@type': 'MobileApplication',
    '@id': `${SITE.origin}/#app`,
    name: 'Pepp',
    alternateName: 'Pepp — Taschengeld & Aufgaben',
    applicationCategory: 'FinanceApplication',
    applicationSubCategory: 'Familienorganisation',
    operatingSystem: 'iOS, Android',
    inLanguage: SITE.lang,
    url: `${SITE.origin}/`,
    image: new URL('/og-image.png', SITE.origin).href,
    screenshot: [
      new URL(screenEltern.src, SITE.origin).href,
      new URL(screenKind.src, SITE.origin).href,
    ],
    description:
      'Familien-App für Aufgaben, Taschengeld und Medienzeit. Aus Aufgaben werden Quests.',
    /* installUrl und downloadUrl sind beide iOS: schema.org kennt kein Feld
       für „zwei Stores". Android steht im sameAs der Organization. */
    installUrl: STORE.ios,
    publisher: { '@id': `${SITE.origin}/#organization` },
    isPartOf: { '@id': `${SITE.origin}/#website` },
    offers: [
      {
        '@type': 'Offer',
        name: 'Monatlich',
        price: PRICING.monthly.toFixed(2),
        priceCurrency: PRICING.currency,
        url: STORE.ios,
      },
      {
        '@type': 'Offer',
        name: 'Jährlich',
        price: PRICING.yearly.toFixed(2),
        priceCurrency: PRICING.currency,
        url: STORE.ios,
      },
    ],
  },
  {
    '@type': 'FAQPage',
    '@id': `${SITE.origin}/#faq`,
    isPartOf: { '@id': `${SITE.origin}/#website` },
    about: { '@id': `${SITE.origin}/#app` },
    mainEntity: FAQ.map((entry) => ({
      '@type': 'Question',
      name: entry.q,
      acceptedAnswer: { '@type': 'Answer', text: entry.a },
    })),
  },
];
---

<Base
  title="Pepp — Taschengeld & Aufgaben als Quests für Familien"
  description={`Pepp macht Familienaufgaben leicht: Kinder erledigen Quests und verdienen Taschengeld oder Medienzeit, Eltern behalten den Überblick. ${PRICING.trialDays} Tage gratis testen — ohne Bankkonto.`}
  ogTitle="Aus Aufgaben werden Quests. — Pepp"
  ogDescription="Kinder sammeln Rewards. Eltern behalten den Überblick. Taschengeld oder Medienzeit als Belohnung — kein Bankkonto, keine Karte."
  twitterDescription={`Die Familien-App für Aufgaben, Taschengeld und Medienzeit. ${PRICING.trialDays} Tage gratis.`}
  jsonLd={jsonLd}
>
  <Nav />
  <main id="main">
    <Hero />
    <TrustBar />
    <Problem />
    <HowItWorks />
    <Rewards />
    <Mechanic />
    <Modes />
    <Pot />
    <Security />
    <Family />
    {
      /* Sektion 11b · Social Proof — AUS DEM FLUSS GENOMMEN, nicht gelöscht.

        Die Sektion bestand aus einer Überschrift und einer gestrichelten Box
        mit dem sichtbaren Text „[PLATZHALTER: Diese Sektion wird nach dem
        Launch mit echten Stimmen befüllt …]". Das wurde live ausgeliefert und
        stand zwischen zwei fertigen Sektionen — eine leere Sektion liest sich
        als Fehler, eine fehlende als Absicht.

        Erfunden wird nichts: keine Zitate, keine Bewertungen, keine Zahlen.
        Das bleibt so (Handoff-Vorgabe, und nach § 5 UWG angreifbar).

        WIEDER EINSETZEN, sobald echte Stimmen und ein Store-Rating vorliegen:
        die Zeile unten entkommentieren und die Platzhalter in
        SocialProof.astro durch die echten Inhalte ersetzen. Die Komponente
        ist unverändert und behält ihre Position zwischen Family und Pricing.

        Siehe Fund 16 in docs/AUDIT-2026-08-17.md. */
    }
    {/* <SocialProof /> */}
    <Pricing />
    <Faq />
    <FinalCta />
  </main>

  <Footer />
  <StickyCta />

  {/* Astro bündelt das als type="module" — laedt also ohne zu blockieren. */}
  <script>
    import '../scripts/site.js';
  </script>
</Base>
