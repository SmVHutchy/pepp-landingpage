# ── Erzeugtes, nichts davon gehört ins Repo ──────────────────────────────
node_modules/
dist/
.astro/

# Screenshot-Vergleiche gegen die Design-Referenz — lokale Artefakte,
# erzeugt von scripts/compare.mjs und scripts/measure.mjs
.compare/

# ── Das gebundene Design System ──────────────────────────────────────────
# 241 MB, davon 180 MB allein in uploads/. Es ist Nachschlagewerk, keine
# Build-Abhängigkeit: nichts unter src/ importiert daraus. Die Werte sind
# bereits nach src/styles/tokens/ übernommen, die Assets nach src/assets/.
# Ein Klon soll nicht 241 MB ziehen, die niemand zum Bauen braucht.
# Begründung ausführlich in docs/DECISIONS.md (ADR-002).
# Wo der Ordner liegt und was drin ist: docs/ARCHITECTURE.md.
Pepp Final Design System/

# ── Persönliche Werkzeuge, keine Projektkonfiguration ────────────────────
# .claude/launch.json bleibt drin (Konfiguration des Dev-Servers, siehe
# docs/SETUP.md). Schreibstil-Skills und Ähnliches sind persönlich.
.claude/skills/
# settings.local.json trägt Endpunkt und Zugangsschlüssel der lokalen
# Agenten-Konfiguration im Klartext. Sie ist persönlich und gehört nie ins
# Repo — bis 01.09.2026 war sie weder ignoriert noch versioniert und wäre
# beim nächsten "git add ." mitgegangen.
.claude/settings.local.json

# ── Betriebssystem und Editoren ──────────────────────────────────────────
.DS_Store
._*
.Spotlight-V100
.Trashes
Thumbs.db
*.log
*.swp
.idea/
.vscode/

# ── Umgebung ─────────────────────────────────────────────────────────────
# Die Seite hat heute keine Umgebungsvariablen (siehe docs/ENVIRONMENT.md).
# Der Eintrag steht vorsorglich, damit ein späteres .env nicht versehentlich
# eingecheckt wird. .env.example gehört dagegen ins Repo.
.env
.env.*
!.env.example

# Sicherungskopien, die scripts/fonts.mjs vor dem Ersetzen anlegt.
# Die Quellschriften liegen im Design System, nicht hier.
public/fonts/*.woff2.vorher

# Wegwerf-Messskripte von Agenten (siehe .prettierignore)
_*.mjs
scripts/_tmp_*.mjs
